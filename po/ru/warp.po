#: htdocs/luci-static/resources/view/warp/overview.js:146
msgid "Registering WARP"
msgstr "Регистрация WARP"

#: htdocs/luci-static/resources/view/warp/overview.js:122
msgid ""
"Registration connects this router to the third-party Cloudflare service and "
"sends a generated public key and device metadata. No private key is sent."
msgstr ""
"При регистрации роутер подключается к стороннему сервису Cloudflare и "
"отправляет созданный публичный ключ и данные устройства. Приватный ключ не "
"отправляется."

#: htdocs/luci-static/resources/view/warp/overview.js:155
#: htdocs/luci-static/resources/view/warp/overview.js:166
#: htdocs/luci-static/resources/view/warp/overview.js:220
msgid "Remove registration"
msgstr "Удалить регистрацию"

#: htdocs/luci-static/resources/view/warp/overview.js:164
msgid "Removing registration"
msgstr "Удаление регистрации"

#: htdocs/luci-static/resources/view/warp/overview.js:227
msgid "Settings"
msgstr "Настройки"

#: htdocs/luci-static/resources/view/warp/overview.js:230
msgid "Start automatically"
msgstr "Автоматический запуск"

#: htdocs/luci-static/resources/view/warp/overview.js:174
msgid "Status"
msgstr "Состояние"

#: htdocs/luci-static/resources/view/warp/overview.js:42
msgid "System time is invalid. Wait for NTP synchronization and try again."
msgstr ""
"Системное время некорректно. Дождитесь синхронизации NTP и повторите попытку."

#: htdocs/luci-static/resources/view/warp/overview.js:46
msgid "TLS verification or negotiation with Cloudflare failed."
msgstr "Ошибка проверки или согласования TLS с Cloudflare."

#: htdocs/luci-static/resources/view/warp/overview.js:54
msgid "The AmneziaWG configuration is missing or invalid."
msgstr "Конфигурация AmneziaWG отсутствует или повреждена."

#: htdocs/luci-static/resources/view/warp/overview.js:40
msgid "The CA certificate bundle is missing."
msgstr "Отсутствует набор корневых сертификатов CA."

#: htdocs/luci-static/resources/view/warp/overview.js:45
msgid "The Cloudflare API request timed out."
msgstr "Истекло время ожидания ответа API Cloudflare."

#: htdocs/luci-static/resources/view/warp/overview.js:50
msgid "The Cloudflare registration service is temporarily unavailable."
msgstr "Сервис регистрации Cloudflare временно недоступен."

#: htdocs/luci-static/resources/view/warp/overview.js:41
msgid "The TUN device is unavailable. Check kmod-tun."
msgstr "Устройство TUN недоступно. Проверьте kmod-tun."

#: htdocs/luci-static/resources/view/warp/overview.js:53
msgid "The WARP account is missing or invalid."
msgstr "Учётная запись WARP отсутствует или повреждена."

#: htdocs/luci-static/resources/view/warp/overview.js:82
msgid "The WARP manager is unavailable."
msgstr "Менеджер WARP недоступен."

#: htdocs/luci-static/resources/view/warp/overview.js:90
msgid "The WARP operation failed."
msgstr "Не удалось выполнить операцию WARP."

#: htdocs/luci-static/resources/view/warp/overview.js:68
msgid "The WARP tunnel service could not be started."
msgstr "Не удалось запустить службу туннеля WARP."

#: htdocs/luci-static/resources/view/warp/overview.js:78
msgid "The application settings could not be committed."
msgstr "Не удалось сохранить настройки приложения."

#: htdocs/luci-static/resources/view/warp/overview.js:58
msgid "The automatic start setting is invalid."
msgstr "Некорректное значение автоматического запуска."

#: htdocs/luci-static/resources/view/warp/overview.js:60
msgid "The configured MTU is invalid."
msgstr "Указано некорректное значение MTU."

#: htdocs/luci-static/resources/view/warp/overview.js:61
msgid "The configured keepalive value is invalid."
msgstr "Указано некорректное значение keepalive."

#: htdocs/luci-static/resources/view/warp/overview.js:65
msgid "The endpoint scan size is invalid."
msgstr "Указан некорректный размер поиска endpoint."

#: htdocs/luci-static/resources/view/warp/overview.js:63
msgid "The excluded country list is invalid."
msgstr "Список исключаемых стран некорректен."

#: htdocs/luci-static/resources/view/warp/overview.js:64
msgid "The excluded endpoint list is invalid."
msgstr "Список исключаемых узлов некорректен."

#: htdocs/luci-static/resources/view/warp/overview.js:77
msgid "The generated network configuration is invalid."
msgstr "Созданная конфигурация сети некорректна."

#: htdocs/luci-static/resources/view/warp/overview.js:71
msgid "The interface could not be brought up."
msgstr "Не удалось поднять интерфейс."

#: htdocs/luci-static/resources/view/warp/overview.js:156
msgid ""
"The managed interface and local registration secrets will be removed. Other "
"network and firewall settings are not touched."
msgstr ""
"Управляемый интерфейс и локальные секреты регистрации будут удалены. "
"Остальные настройки сети и firewall не изменятся."

#: htdocs/luci-static/resources/view/warp/overview.js:67
msgid "The managed interface is missing."
msgstr "Управляемый интерфейс отсутствует."

#: htdocs/luci-static/resources/view/warp/overview.js:73
msgid "The managed network sections could not be backed up."
msgstr "Не удалось сохранить резервную копию управляемых сетевых секций."

#: htdocs/luci-static/resources/view/warp/overview.js:62
msgid "The masking hostname is invalid."
msgstr "Указано некорректное маскирующее имя."

#: htdocs/luci-static/resources/view/warp/overview.js:75
msgid "The network configuration could not be committed."
msgstr "Не удалось сохранить конфигурацию сети."

#: htdocs/luci-static/resources/view/warp/overview.js:74
msgid "The network configuration rollback failed."
msgstr "Не удалось откатить конфигурацию сети."

#: htdocs/luci-static/resources/view/warp/overview.js:81
msgid "The operation lock could not be acquired."
msgstr "Не удалось получить блокировку операции."

#: htdocs/luci-static/resources/view/warp/overview.js:59
msgid "The preferred interface name is invalid."
msgstr "Некорректное предпочтительное имя интерфейса."

#: htdocs/luci-static/resources/view/warp/overview.js:80
msgid "The protected registration data could not be saved."
msgstr "Не удалось сохранить защищённые данные регистрации."

#: htdocs/luci-static/resources/view/warp/overview.js:79
msgid "The protected registration directory could not be created."
msgstr "Не удалось создать защищённый каталог регистрации."

#: htdocs/luci-static/resources/view/warp/overview.js:84
msgid "The requested operation is not allowed."
msgstr "Запрошенная операция запрещена."

#: htdocs/luci-static/resources/view/warp/overview.js:70
msgid "The selected endpoint did not pass traffic."
msgstr "Выбранный endpoint не пропускает трафик."

#: htdocs/luci-static/resources/view/warp/overview.js:57
msgid "The stored backend name is invalid."
msgstr "Сохранено некорректное имя backend."

#: htdocs/luci-static/resources/view/warp/overview.js:76
msgid "The temporary UCI transaction could not be created."
msgstr "Не удалось создать временную транзакцию UCI."

#: htdocs/luci-static/resources/view/warp/overview.js:69
msgid "Timed out waiting for the WARP tunnel interface. Check the system log."
msgstr ""
"Истекло время ожидания туннельного интерфейса WARP. Проверьте системный "
"журнал."

#: htdocs/luci-static/resources/view/warp/overview.js:275
msgid ""
"Traffic uses WAN until you select this interface in your routing "
"configuration. Reconnect scans for a new verified endpoint."
msgstr "Трафик использует WAN, пока этот интерфейс не выбран в настройках маршрутизации. Переподключение ищет новый проверенный endpoint."

#: htdocs/luci-static/resources/view/warp/overview.js:172
msgid "Unknown"
msgstr "Неизвестно"

#: htdocs/luci-static/resources/view/warp/overview.js:238
msgid ""
"Use 1–15 letters, digits or underscores; the first character must not be a "
"digit."
msgstr ""
"Используйте от 1 до 15 букв, цифр или знаков подчёркивания; первый символ не "
"должен быть цифрой."

#: htdocs/luci-static/resources/view/warp/overview.js:268
msgid "Use comma-separated two-letter country codes, for example RU,BY."
msgstr "Введите двухбуквенные коды стран через запятую, например RU,BY."

#: htdocs/luci-static/resources/view/warp/overview.js:255
msgid "Used only in the fake first AWG packet; it does not change DNS."
msgstr "Используется только в маскирующем первом пакете AWG и не меняет DNS."

