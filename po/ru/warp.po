msgid "The interface could not be brought up."
msgstr "Не удалось поднять интерфейс."

#: htdocs/luci-static/resources/view/warp/overview.js:162
msgid ""
"The managed interface and local registration secrets will be removed. Other "
"network and firewall settings are not touched."
msgstr ""
"Управляемый интерфейс и локальные секреты регистрации будут удалены. "
"Остальные настройки сети и firewall не изменятся."

#: htdocs/luci-static/resources/view/warp/overview.js:73
msgid "The managed interface is missing."
msgstr "Управляемый интерфейс отсутствует."

#: htdocs/luci-static/resources/view/warp/overview.js:79
msgid "The managed network sections could not be backed up."
msgstr "Не удалось сохранить резервную копию управляемых сетевых секций."

#: htdocs/luci-static/resources/view/warp/overview.js:63
msgid "The masking hostname is invalid."
msgstr "Указано некорректное маскирующее имя."

#: htdocs/luci-static/resources/view/warp/overview.js:81
msgid "The network configuration could not be committed."
msgstr "Не удалось сохранить конфигурацию сети."

#: htdocs/luci-static/resources/view/warp/overview.js:80
msgid "The network configuration rollback failed."
msgstr "Не удалось откатить конфигурацию сети."

#: htdocs/luci-static/resources/view/warp/overview.js:87
msgid "The operation lock could not be acquired."
msgstr "Не удалось получить блокировку операции."

#: htdocs/luci-static/resources/view/warp/overview.js:60
msgid "The preferred interface name is invalid."
msgstr "Некорректное предпочтительное имя интерфейса."

#: htdocs/luci-static/resources/view/warp/overview.js:86
msgid "The protected registration data could not be saved."
msgstr "Не удалось сохранить защищённые данные регистрации."

#: htdocs/luci-static/resources/view/warp/overview.js:85
msgid "The protected registration directory could not be created."
msgstr "Не удалось создать защищённый каталог регистрации."

#: htdocs/luci-static/resources/view/warp/overview.js:90
msgid "The requested operation is not allowed."
msgstr "Запрошенная операция запрещена."

#: htdocs/luci-static/resources/view/warp/overview.js:64
msgid "The required Cloudflare node country list is invalid."
msgstr "Список требуемых стран узлов Cloudflare некорректен."

#: htdocs/luci-static/resources/view/warp/overview.js:65
msgid "The required Cloudflare node list is invalid."
msgstr "Список требуемых узлов Cloudflare некорректен."

#: htdocs/luci-static/resources/view/warp/overview.js:76
msgid "The selected endpoint did not pass traffic."
msgstr "Выбранный endpoint не пропускает трафик."

#: htdocs/luci-static/resources/view/warp/overview.js:58
msgid "The stored backend name is invalid."
msgstr "Сохранено некорректное имя backend."

#: htdocs/luci-static/resources/view/warp/overview.js:82
msgid "The temporary UCI transaction could not be created."
msgstr "Не удалось создать временную транзакцию UCI."

#: htdocs/luci-static/resources/view/warp/overview.js:54
msgid "The temporary endpoint scanner could not be downloaded."
msgstr "Не удалось скачать временный сканер endpoint."

#: htdocs/luci-static/resources/view/warp/overview.js:56
msgid "The temporary endpoint scanner could not be unpacked."
msgstr "Не удалось распаковать временный сканер endpoint."

#: htdocs/luci-static/resources/view/warp/overview.js:55
msgid "The temporary endpoint scanner failed its integrity check."
msgstr "Временный сканер endpoint не прошёл проверку целостности."

#: htdocs/luci-static/resources/view/warp/overview.js:318
msgid "The upstream interface cannot be the WARP interface."
msgstr "Вышестоящий интерфейс не может совпадать с интерфейсом WARP."

#: htdocs/luci-static/resources/view/warp/overview.js:69
msgid "The upstream interface is unavailable."
msgstr "Вышестоящий интерфейс недоступен."

#: htdocs/luci-static/resources/view/warp/overview.js:68
msgid "The upstream interface name is invalid."
msgstr "Имя вышестоящего интерфейса некорректно."

#: htdocs/luci-static/resources/view/warp/overview.js:70
msgid "The upstream interface would create a routing loop."
msgstr "Вышестоящий интерфейс создаст петлю маршрутизации."

#: htdocs/luci-static/resources/view/warp/overview.js:57
msgid "This router architecture is not supported."
msgstr "Архитектура этого роутера не поддерживается."

#: htdocs/luci-static/resources/view/warp/overview.js:75
msgid "Timed out waiting for the WARP tunnel interface. Check the system log."
msgstr ""
"Истекло время ожидания туннельного интерфейса WARP. Проверьте системный "
"журнал."

#: htdocs/luci-static/resources/view/warp/overview.js:325
msgid ""
"Traffic uses the normal route until you select this interface in your "
"routing configuration. Reconnect keeps the current endpoint; endpoint search "
"is a separate action."
msgstr ""
"Трафик использует обычный маршрут, пока этот интерфейс не выбран в настройках "
"маршрутизации. Переподключение сохраняет текущий endpoint; его поиск запускается "
"отдельно."

#: htdocs/luci-static/resources/view/warp/overview.js:178
msgid "Unknown"
msgstr "Неизвестно"

#: htdocs/luci-static/resources/view/warp/overview.js:190
#: htdocs/luci-static/resources/view/warp/overview.js:309
msgid "Upstream interface"
msgstr "Вышестоящий интерфейс"

#: htdocs/luci-static/resources/view/warp/overview.js:252
msgid ""
"Use 1–15 letters, digits or underscores; the first character must not be a "
"digit."
msgstr ""
"Используйте от 1 до 15 букв, цифр или знаков подчёркивания; первый символ не "
"должен быть цифрой."

#: htdocs/luci-static/resources/view/warp/overview.js:289
msgid "Use comma-separated three-letter node codes, for example AMS,FRA."
msgstr "Введите трёхбуквенные коды узлов через запятую, например AMS,FRA."

#: htdocs/luci-static/resources/view/warp/overview.js:306
msgid "Use comma-separated three-letter node codes, for example DME,LED."
msgstr "Введите трёхбуквенные коды узлов через запятую, например DME,LED."

#: htdocs/luci-static/resources/view/warp/overview.js:281
msgid "Use comma-separated two-letter country codes, for example NL,DE."
msgstr "Введите двухбуквенные коды стран через запятую, например NL,DE."

#: htdocs/luci-static/resources/view/warp/overview.js:298
msgid "Use comma-separated two-letter country codes, for example RU,BY."
msgstr "Введите двухбуквенные коды стран через запятую, например RU,BY."

#: htdocs/luci-static/resources/view/warp/overview.js:317
msgid ""
"Use the logical OpenWrt interface name, up to 15 letters, digits or "
"underscores."
msgstr ""
"Введите логическое имя интерфейса OpenWrt длиной до 15 букв, цифр или знаков "
"подчёркивания."

#: htdocs/luci-static/resources/view/warp/overview.js:269
msgid "Used only in the fake first AWG packet; it does not change DNS."
msgstr "Используется только в маскирующем первом пакете AWG и не меняет DNS."

#: root/usr/share/rpcd/acl.d/luci-app-warp.json:3
msgid "View and manage the standalone WARP interface"
msgstr "Просмотр и управление отдельным интерфейсом WARP"

#: htdocs/luci-static/resources/view/warp/overview.js:323
#: root/usr/share/luci/menu.d/luci-app-warp.json:3
msgid "WARP"
msgstr "WARP"

#: htdocs/luci-static/resources/view/warp/overview.js:52
msgid "WARP registration failed. Check /etc/warp/backend.log."
msgstr "Не удалось зарегистрировать WARP. Проверьте /etc/warp/backend.log."

#: htdocs/luci-static/resources/view/warp/overview.js:78
msgid "netifd could not reload the network configuration."
msgstr "netifd не смог перечитать конфигурацию сети."
