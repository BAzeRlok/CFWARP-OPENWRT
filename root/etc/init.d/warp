#!/bin/sh /etc/rc.common

USE_PROCD=1
START=96
STOP=04

STATE_DIR="/etc/warp"
DISABLED_FILE="$STATE_DIR/disabled"
FORCE_START_FILE="/tmp/warp-force-start"

start_service() {
	local auto_start backend interface_name mtu keepalive ipv4 ipv6 transport sni
	local prog config_file

	[ ! -e "$DISABLED_FILE" ] || return 0

	config_load warp
	config_get_bool auto_start main auto_start 1
	[ "$auto_start" -eq 1 ] || [ -e "$FORCE_START_FILE" ] || return 0
	config_get backend main actual_backend ''
	config_get interface_name main actual_interface warp
	config_get mtu main mtu 1280
	config_get keepalive main keepalive 5
	config_get_bool ipv4 main ipv4 1
	config_get_bool ipv6 main ipv6 1
	config_get transport main masque_transport http2
	config_get sni main masque_sni ozon.ru
	[ -n "$sni" ] || sni=ozon.ru
	[ "$backend" = usque_masque ] || return 0

	mkdir -p "$STATE_DIR"
	chmod 700 "$STATE_DIR"

	prog=/usr/libexec/warp-usque
	config_file="$STATE_DIR/usque.json"
	[ -x "$prog" ] || return 1
	[ -s "$config_file" ] || return 0

	procd_open_instance warp
	procd_set_param command "$prog" --config "$config_file" nativetun \
		--interface-name "$interface_name" --mtu "$mtu" \
		--keepalive-period "${keepalive}s" --reconnect-delay 1s \
		--always-reconnect --sni-address "$sni"
	[ "$transport" != http2 ] || procd_append_param command --http2
	[ "$transport" != auto ] || procd_append_param command --http2-fallback
	[ "$ipv4" -eq 1 ] || procd_append_param command --no-tunnel-ipv4
	[ "$ipv6" -eq 1 ] || procd_append_param command --no-tunnel-ipv6
	procd_set_param file "$config_file"
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param term_timeout 10
	procd_set_param respawn 3600 5 5
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger warp
}
