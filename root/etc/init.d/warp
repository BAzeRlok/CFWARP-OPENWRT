#!/bin/sh /etc/rc.common

USE_PROCD=1
START=96
STOP=04

STATE_DIR="/etc/warp"
DISABLED_FILE="$STATE_DIR/disabled"
FORCE_START_FILE="/tmp/warp-force-start"

start_service() {
	local auto_start backend interface_name

	[ ! -e "$DISABLED_FILE" ] || return 0

	config_load warp
	config_get_bool auto_start main auto_start 1
	[ "$auto_start" -eq 1 ] || [ -e "$FORCE_START_FILE" ] || return 0
	config_get backend main actual_backend ''
	config_get interface_name main actual_interface warp
	[ "$backend" = amneziawg ] || return 0
	[ -x /usr/libexec/warp-awg-runner ] || return 1
	[ -s "$STATE_DIR/awg-account.json" ] || return 0
	[ -s "$STATE_DIR/awg.conf" ] || return 0

	procd_open_instance warp
	procd_set_param command /usr/libexec/warp-awg-runner "$interface_name"
	procd_set_param file "$STATE_DIR/awg-account.json" "$STATE_DIR/awg.conf"
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param term_timeout 10
	procd_set_param respawn 3600 5 5
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger warp
}
