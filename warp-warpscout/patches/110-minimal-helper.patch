+package main
+
+import (
+	"flag"
+	"fmt"
+	"io"
+	"net/netip"
+	"os"
+	"strings"
+)
+
+type options struct {
+	tunnelParallel int
+	timeoutSec     int
+	perSubnet      int
+	tunPingCount   int
+	mtu            int
+	port           int
+	proto          string
+	output         string
+	conf           string
+	relay          string
+	iface          string
+	accountPath    string
+	genI1          string
+	i1Host         string
+	pingTarget     string
+	target         string
+	node           string
+	country        string
+	excludeNode    string
+	excludeCountry string
+	targets        []netip.Prefix
+	colos          []string
+	countries      []string
+	dropColos      []string
+	dropCountries  []string
+	freshAccount   bool
+	noReport       bool
+	tableOff       bool
+	noDNS          bool
+	i1Explicit     bool
+	tunPingCheck   bool
+	wantMeta       bool
+	plain          bool
+}
+
+type flagSpec struct{ short, long, meta, help string }
+type flagGroup struct {
+	title string
+	specs []flagSpec
+}
+
+var (
+	scanGroup = flagGroup{"Scan", []flagSpec{
+		{"", "account", "FILE", "WARP account file"},
+		{"", "interface", "NAME", "bind probes to this interface"},
+		{"", "target", "ADDR", "comma-separated IPv4 addresses or CIDRs"},
+		{"", "sample", "N", "addresses sampled per subnet"},
+		{"", "tunnel-jobs", "N", "parallel AWG tunnel workers"},
+		{"", "tun-ping-count", "N", "in-tunnel durability probes"},
+		{"", "ping-target", "ADDR", "in-tunnel ping target"},
+		{"", "country", "ISO", "required Cloudflare node countries"},
+		{"", "node", "COLO", "required Cloudflare node codes"},
+		{"", "exclude-country", "ISO", "excluded Cloudflare node countries"},
+		{"", "exclude-node", "COLO", "excluded Cloudflare node codes"},
+		{"", "conf", "FILE", "write the best native AWG configuration"},
+		{"", "output", "FILE", "write the compact endpoint report"},
+	}}
+	awgGroup = flagGroup{"AmneziaWG", []flagSpec{
+		{"", "gen-i1", "PROTO", "generate an AWG initiation packet"},
+		{"", "i1-sni", "HOST", "host imitated by the initiation packet"},
+	}}
+	plainGroup = flagGroup{"Output", []flagSpec{{"", "plain", "", "plain non-interactive output"}}}
+)
+
+const defaultTunnelJobs = 2
+
+func setupScanFlags(fs *flag.FlagSet, o *options) {
+	fs.IntVar(&o.timeoutSec, "timeout", 2, "")
+	fs.StringVar(&o.iface, "interface", "", "")
+	fs.StringVar(&o.accountPath, "account", defaultAccount, "")
+	fs.StringVar(&o.target, "target", "", "")
+	fs.IntVar(&o.tunnelParallel, "tunnel-jobs", defaultTunnelJobs, "")
+	fs.IntVar(&o.perSubnet, "sample", 5, "")
+	fs.IntVar(&o.port, "port", 0, "")
+	fs.StringVar(&o.pingTarget, "ping-target", "", "")
+	fs.StringVar(&o.proto, "proto", protoAWG, "")
+	fs.StringVar(&o.output, "output", "", "")
+	fs.StringVar(&o.output, "o", "", "")
+	fs.BoolVar(&o.noReport, "no-report", false, "")
+	fs.IntVar(&o.tunPingCount, "tun-ping-count", 0, "")
+	fs.StringVar(&o.node, "node", "", "")
+	fs.StringVar(&o.country, "country", "", "")
+	fs.StringVar(&o.excludeNode, "exclude-node", "", "")
+	fs.StringVar(&o.excludeCountry, "exclude-country", "", "")
+	fs.StringVar(&o.conf, "conf", "", "")
+	fs.BoolVar(&o.tableOff, "table-off", false, "")
+	fs.IntVar(&o.mtu, "mtu", 0, "")
+	fs.BoolVar(&o.noDNS, "no-dns", false, "")
+	fs.BoolVar(&o.plain, "plain", false, "")
+	addAWGFlags(fs, o)
+	o.wantMeta = true
+}
+
+func setupRegisterFlags(fs *flag.FlagSet, o *options) {
+	fs.IntVar(&o.timeoutSec, "timeout", 2, "")
+	fs.StringVar(&o.iface, "interface", "", "")
+	fs.StringVar(&o.accountPath, "account", defaultAccount, "")
+	fs.StringVar(&o.target, "target", "", "")
+	fs.StringVar(&o.relay, "relay", "none", "")
+	fs.BoolVar(&o.freshAccount, "fresh", false, "")
+	fs.BoolVar(&o.plain, "plain", false, "")
+	addAWGFlags(fs, o)
+	o.proto = protoAWG
+	o.perSubnet = registerSample
+}
+
+func addAWGFlags(fs *flag.FlagSet, o *options) {
+	fs.StringVar(&o.genI1, "gen-i1", "", "")
+	fs.StringVar(&o.i1Host, "i1-sni", "", "")
+	fs.IntVar(&awgJc, "jc", awgJc, "")
+	fs.IntVar(&awgJmin, "jmin", awgJmin, "")
+	fs.IntVar(&awgJmax, "jmax", awgJmax, "")
+	fs.StringVar(&awgI1, "i1", awgI1, "")
+}
+
+func applyCommonFlags(fs *flag.FlagSet, o *options) {
+	if fs.NArg() > 0 {
+		fmt.Fprintf(os.Stderr, "unexpected argument %q\n", fs.Arg(0))
+		os.Exit(2)
+	}
+	if strings.HasPrefix(o.conf, "-") && o.conf != confStdout {
+		fmt.Fprintf(os.Stderr, "-conf needs a file name, got %q\n", o.conf)
+		os.Exit(2)
+	}
+	if strings.HasPrefix(o.output, "-") {
+		fmt.Fprintf(os.Stderr, "-output needs a file name, got %q\n", o.output)
+		os.Exit(2)
+	}
+	if o.proto != protoAWG {
+		fmt.Fprintln(os.Stderr, "this build supports only -proto awg")
+		os.Exit(2)
+	}
+	if o.relay != "" && o.relay != "none" {
+		fmt.Fprintln(os.Stderr, "this build supports only -relay none")
+		os.Exit(2)
+	}
+	if o.perSubnet < 1 || o.tunnelParallel < 1 {
+		fmt.Fprintln(os.Stderr, "-sample and -tunnel-jobs must be at least 1")
+		os.Exit(2)
+	}
+	if o.port < 0 || o.port > 65535 {
+		fmt.Fprintln(os.Stderr, "-port must be between 1 and 65535")
+		os.Exit(2)
+	}
+	if o.tunPingCount > 0 {
+		o.tunPingCheck = true
+	}
+	if o.tunPingCount > 0 && o.tunPingCount < minDurabilityPings {
+		fmt.Fprintf(os.Stderr, "-tun-ping-count must be at least %d\n", minDurabilityPings)
+		os.Exit(2)
+	}
+	if awgI1 == i1Keyword {
+		awgI1 = ""
+	}
+	explicit := explicitFlags(fs)
+	o.i1Explicit = explicit["i1"] || o.genI1 != ""
+	if o.genI1 == "" && explicit["i1-sni"] {
+		fmt.Fprintln(os.Stderr, "-i1-sni needs -gen-i1")
+		os.Exit(2)
+	}
+	if o.genI1 != "" {
+		if explicit["i1"] {
+			fmt.Fprintln(os.Stderr, "-gen-i1 and -i1 cannot be combined")
+			os.Exit(2)
+		}
+		if err := regenI1(*o); err != nil {
+			fmt.Fprintln(os.Stderr, err)
+			os.Exit(2)
+		}
+	}
+	validateJunkParams()
+	if o.mtu != 0 && (o.mtu < mtuMin || o.mtu > mtuMax) {
+		fmt.Fprintf(os.Stderr, "-mtu must be between %d and %d\n", mtuMin, mtuMax)
+		os.Exit(2)
+	}
+	applyPingTarget(o)
+	applyTarget(o)
+	o.colos = splitList(o.node, "-node")
+	o.countries = splitList(o.country, "-country")
+	o.dropColos = splitList(o.excludeNode, "-exclude-node")
+	o.dropCountries = splitList(o.excludeCountry, "-exclude-country")
+}
+
+func explicitFlags(fs *flag.FlagSet) map[string]bool {
+	set := make(map[string]bool)
+	fs.Visit(func(value *flag.Flag) { set[value.Name] = true })
+	return set
+}
+
+func validateJunkParams() {
+	if awgJc < junkCountLimitMin || awgJc > junkCountLimitMax || awgJmin > awgJmax || awgJmax > tunnelMTU {
+		fmt.Fprintln(os.Stderr, "invalid AmneziaWG junk parameters")
+		os.Exit(2)
+	}
+}
+
+func applyPingTarget(o *options) {
+	if o.pingTarget == "" {
+		return
+	}
+	if !o.tunPingCheck {
+		fmt.Fprintln(os.Stderr, "-ping-target needs -tun-ping-count")
+		os.Exit(2)
+	}
+	if address, err := netip.ParseAddr(o.pingTarget); err == nil {
+		if !address.Is4() {
+			fmt.Fprintln(os.Stderr, "-ping-target must be IPv4")
+			os.Exit(2)
+		}
+		pingTarget = address.String()
+		return
+	}
+	if strings.ContainsAny(o.pingTarget, ":/ ") {
+		fmt.Fprintf(os.Stderr, "invalid -ping-target %q\n", o.pingTarget)
+		os.Exit(2)
+	}
+	pingTarget = o.pingTarget
+}
+
+func applyTarget(o *options) {
+	if o.target == "" {
+		return
+	}
+	targets, err := parseTargets(o.target)
+	if err != nil {
+		fmt.Fprintln(os.Stderr, err)
+		os.Exit(2)
+	}
+	for _, target := range targets {
+		if !target.Addr().Is4() {
+			fmt.Fprintln(os.Stderr, "this build scans IPv4 endpoints only")
+			os.Exit(2)
+		}
+	}
+	o.targets = targets
+}
+
+func splitList(value, name string) []string {
+	if value == "" {
+		return nil
+	}
+	var out []string
+	for _, item := range strings.Split(value, ",") {
+		if item = strings.ToUpper(strings.TrimSpace(item)); item != "" {
+			out = append(out, item)
+		}
+	}
+	if len(out) == 0 {
+		fmt.Fprintln(os.Stderr, name+" is empty")
+		os.Exit(2)
+	}
+	return out
+}
+
+func rootUsage(w io.Writer) {
+	fmt.Fprintln(w, "warp-scanner - WARP registration and AWG endpoint verification")
+	fmt.Fprintln(w, "usage: warp-scanner <scan|register> [options]")
+}
+
+func commandUsage(w io.Writer, cmd command, fs *flag.FlagSet) {
+	fmt.Fprintf(w, "warp-scanner %s - %s\n\n", cmd.name, cmd.brief)
+	fs.PrintDefaults()
+}
diff --git a/mini_report.go b/mini_report.go
new file mode 100644
index 0000000..df8e1a9
--- /dev/null
+++ b/mini_report.go
@@ -0,0 +1,210 @@
+package main
+
+import (
+	"fmt"
+	"io"
+	"net/netip"
+	"os"
+	"sort"
+	"strings"
+	"time"
+)
+
+type endpointResult struct {
+	ip       netip.Addr
+	endpoint string
+	exit     metaResult
+	epPing   time.Duration
+	tunPing  time.Duration
+	loss     float32
+	measured bool
+	ok       bool
+	durable  bool
+}
+
+func (r endpointResult) working() bool  { return r.ok && r.durable }
+func (r endpointResult) tornDown() bool { return r.ok && !r.durable }
+
+func (r endpointResult) sortPing() time.Duration {
+	if r.measured {
+		return r.tunPing
+	}
+	return r.epPing
+}
+
+func latencyStr(d time.Duration) string {
+	if d <= 0 {
+		return "?"
+	}
+	if d < time.Millisecond {
+		return fmt.Sprintf("%.2fms", float64(d)/float64(time.Millisecond))
+	}
+	return fmt.Sprintf("%dms", d.Milliseconds())
+}
+
+func (r endpointResult) lossStr() string {
+	if !r.measured {
+		return "-"
+	}
+	return fmt.Sprintf("%.0f%%", r.loss*100)
+}
+
+func exitRegion(t metaResult) string {
+	if t.loc == "" {
+		return "?"
+	}
+	return t.loc
+}
+
+func exitColo(t metaResult) string {
+	if t.colo == "" {
+		return "?"
+	}
+	return t.colo
+}
+
+func exitColoLocation(t metaResult) string { return coloLocation(t) }
+
+func withFlag(flag, code string) string {
+	if flag == "" {
+		return code
+	}
+	return flag + " " + code
+}
+
+type phaseResult struct {
+	run     protoRun
+	results []endpointResult
+}
+
+func filterResults(ph phaseResult, keep func(endpointResult) bool) phaseResult {
+	kept := make([]endpointResult, 0, len(ph.results))
+	for _, result := range ph.results {
+		if keep(result) {
+			kept = append(kept, result)
+		}
+	}
+	return phaseResult{run: ph.run, results: kept}
+}
+
+func upperSet(values []string) map[string]struct{} {
+	set := make(map[string]struct{}, len(values))
+	for _, value := range values {
+		set[strings.ToUpper(value)] = struct{}{}
+	}
+	return set
+}
+
+func filterByColo(ph phaseResult, values []string, want bool) phaseResult {
+	set := upperSet(values)
+	return filterResults(ph, func(result endpointResult) bool {
+		_, exists := set[strings.ToUpper(result.exit.colo)]
+		return exists == want
+	})
+}
+
+func filterByCountry(ph phaseResult, values []string, want bool) phaseResult {
+	set := upperSet(values)
+	return filterResults(ph, func(result endpointResult) bool {
+		if result.exit.coloISO == "" {
+			return !want
+		}
+		_, exists := set[strings.ToUpper(result.exit.coloISO)]
+		return exists == want
+	})
+}
+
+func lessDuration(a, b time.Duration) bool {
+	if (a <= 0) != (b <= 0) {
+		return a > 0
+	}
+	return a < b
+}
+
+func lessByLossRTT(a, b endpointResult) bool {
+	if a.loss != b.loss {
+		return a.loss < b.loss
+	}
+	if a.sortPing() != b.sortPing() {
+		return lessDuration(a.sortPing(), b.sortPing())
+	}
+	return a.endpoint < b.endpoint
+}
+
+func sortedResults(results []endpointResult, keep func(endpointResult) bool) []endpointResult {
+	out := make([]endpointResult, 0, len(results))
+	for _, result := range results {
+		if keep(result) {
+			out = append(out, result)
+		}
+	}
+	sort.Slice(out, func(i, j int) bool { return lessByLossRTT(out[i], out[j]) })
+	return out
+}
+
+func workingSorted(results []endpointResult) []endpointResult {
+	return sortedResults(results, endpointResult.working)
+}
+
+func tornSorted(results []endpointResult) []endpointResult {
+	return sortedResults(results, endpointResult.tornDown)
+}
+
+func poolsWithHits(ph phaseResult) []netip.Prefix {
+	out := make([]netip.Prefix, 0, len(pools))
+	for _, pool := range pools {
+		for _, result := range ph.results {
+			if pool.Contains(result.ip) {
+				out = append(out, pool)
+				break
+			}
+		}
+	}
+	return out
+}
+
+func writeRows(w io.Writer, results []endpointResult, ping bool) {
+	if ping {
+		fmt.Fprintf(w, "%-22s %-13s %-9s %-6s %-10s %-6s %s\n", "ENDPOINT", "ENDPOINT PING", "TUN PING", "LOSS", "SEEN AS", "NODE", "NODE LOCATION")
+		for _, result := range results {
+			fmt.Fprintf(w, "%-22s %-13s %-9s %-6s %-10s %-6s %s\n", result.endpoint, latencyStr(result.epPing), latencyStr(result.tunPing), result.lossStr(), exitRegion(result.exit), exitColo(result.exit), exitColoLocation(result.exit))
+		}
+		return
+	}
+	fmt.Fprintf(w, "%-22s %-13s %-10s %-6s %s\n", "ENDPOINT", "ENDPOINT PING", "SEEN AS", "NODE", "NODE LOCATION")
+	for _, result := range results {
+		fmt.Fprintf(w, "%-22s %-13s %-10s %-6s %s\n", result.endpoint, latencyStr(result.epPing), exitRegion(result.exit), exitColo(result.exit), exitColoLocation(result.exit))
+	}
+}
+
+func writeFullReport(w io.Writer, ph phaseResult, ping bool) {
+	working := workingSorted(ph.results)
+	torn := tornSorted(ph.results)
+	fmt.Fprintf(w, "# WARP endpoints: %d working / %d probed\n", len(working), len(ph.results))
+	if ping {
+		fmt.Fprintf(w, "# sorted by in-tunnel loss, then in-tunnel ping\n")
+	} else {
+		fmt.Fprintf(w, "# sorted by ping to the endpoint\n")
+	}
+	if len(working) > 0 {
+		fmt.Fprintln(w)
+		writeRows(w, working, ping)
+	}
+	if len(torn) > 0 {
+		fmt.Fprintf(w, "\n# %d torn down (handshake ok, data flowed, then stopped)\n", len(torn))
+		writeRows(w, torn, ping)
+	}
+}
+
+func writeConsole(w io.Writer, ph phaseResult, ping bool) {
+	writeFullReport(w, ph, ping)
+}
+
+func writeToFile(path string, ph phaseResult, ping bool) error {
+	file, err := os.Create(path)
+	if err != nil {
+		return err
+	}
+	writeFullReport(file, ph, ping)
+	return file.Close()
+}
