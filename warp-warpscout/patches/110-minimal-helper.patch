new file mode 100644
index 0000000..a170483
--- /dev/null
+++ b/mini_conf.go
@@ -0,0 +1,48 @@
+package main
+
+import (
+	"fmt"
+	"os"
+	"strings"
+)
+
+const confStdout = "-"
+
+func renderConf(o options, endpoint string, run protoRun) string {
+	var out strings.Builder
+	fmt.Fprintln(&out, "[Interface]")
+	fmt.Fprintf(&out, "Address = %s/32, %s/128\n", warpAddress, warpAddressV6)
+	fmt.Fprintf(&out, "PrivateKey = %s\n", warpPrivateKey)
+	if !o.noDNS {
+		fmt.Fprintln(&out, "DNS = 1.1.1.1, 1.0.0.1")
+	}
+	if o.mtu > 0 {
+		fmt.Fprintf(&out, "MTU = %d\n", o.mtu)
+	}
+	if o.tableOff {
+		fmt.Fprintln(&out, "Table = off")
+	}
+	if run.isAWG() {
+		fmt.Fprintf(&out, "Jc = %d\n", awgJc)
+		fmt.Fprintf(&out, "Jmin = %d\n", awgJmin)
+		fmt.Fprintf(&out, "Jmax = %d\n", awgJmax)
+		if awgI1 != "" {
+			fmt.Fprintf(&out, "I1 = %s\n", awgI1)
+		}
+	}
+	fmt.Fprintln(&out, "\n[Peer]")
+	fmt.Fprintf(&out, "PublicKey = %s\n", warpPublicKey)
+	fmt.Fprintf(&out, "Endpoint = %s\n", endpoint)
+	fmt.Fprintln(&out, "AllowedIPs = 0.0.0.0/0, ::/0")
+	fmt.Fprintf(&out, "PersistentKeepalive = %d\n", keepalive)
+	return out.String()
+}
+
+func writeConf(o options, endpoint string, run protoRun) error {
+	data := []byte(renderConf(o, endpoint, run))
+	if o.conf == confStdout {
+		_, err := os.Stdout.Write(data)
+		return err
+	}
+	return os.WriteFile(o.conf, data, 0600)
+}
