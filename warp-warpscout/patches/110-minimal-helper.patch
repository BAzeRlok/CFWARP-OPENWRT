new file mode 100644
index 0000000..e940fa2
--- /dev/null
+++ b/mini_ui.go
@@ -0,0 +1,110 @@
+package main
+
+import (
+	"fmt"
+	"io"
+	"os"
+	"sync"
+	"sync/atomic"
+	"time"
+)
+
+type stepMsg struct {
+	label, summary string
+	done, fail     bool
+}
+
+type barBeginMsg struct {
+	label string
+	total int
+}
+
+type probedMsg struct{}
+
+type foundMsg struct {
+	endpoint string
+	epPing   time.Duration
+	tunPing  time.Duration
+	loss     float32
+	measured bool
+	exit     string
+	colo     string
+	torn     bool
+}
+
+type barEndMsg struct{ label, summary string }
+type doneMsg struct{}
+type emitter func(any)
+
+var (
+	plainNodes sync.Map
+	plainOut   io.Writer = os.Stderr
+	plainTotal atomic.Int64
+	plainStep  atomic.Int64
+	plainDone  atomic.Int64
+)
+
+const plainProgressSteps = 10
+
+func plainEmit(msg any) {
+	switch m := msg.(type) {
+	case stepMsg:
+		switch {
+		case m.fail:
+			fmt.Fprintln(plainOut, m.summary)
+		case m.done:
+			fmt.Fprintf(plainOut, "%s: %s\n", m.label, m.summary)
+		default:
+			fmt.Fprintln(plainOut, m.label+"...")
+		}
+	case barBeginMsg:
+		plainTotal.Store(int64(m.total))
+		plainStep.Store(int64(max(1, m.total/plainProgressSteps)))
+		plainDone.Store(0)
+		fmt.Fprintf(plainOut, "%s: %d...\n", m.label, m.total)
+	case probedMsg:
+		step, total := plainStep.Load(), plainTotal.Load()
+		if step == 0 {
+			return
+		}
+		if done := plainDone.Add(1); done%step == 0 && done < total {
+			fmt.Fprintf(plainOut, "  %d/%d\n", done, total)
+		}
+	case foundMsg:
+		if m.exit == "" || m.torn {
+			return
+		}
+		if _, seen := plainNodes.LoadOrStore(m.exit+" "+m.colo, true); !seen {
+			fmt.Fprintf(plainOut, "  node: %s %s (%s)\n", m.exit, m.colo, m.endpoint)
+		}
+	case barEndMsg:
+		fmt.Fprintf(plainOut, "%s: %s\n", m.label, m.summary)
+	}
+}
+
+type palette struct{}
+
+func (palette) title(s string) string  { return s }
+func (palette) ok(s string) string     { return s }
+func (palette) fail(s string) string   { return s }
+func (palette) dim(s string) string    { return s }
+func (palette) warn(s string) string   { return s }
+func (palette) accent(s string) string { return s }
+func (palette) addr(s string) string   { return s }
+
+var errPal palette
+
+func i1Note() string { return i1NoteFor(awgI1, genI1Label) }
+
+func i1NoteFor(packet, label string) string {
+	if label != "" {
+		return label
+	}
+	if packet == "" {
+		return "no I1"
+	}
+	if packet == i1Default {
+		return "built-in I1"
+	}
+	return "custom I1"
+}
