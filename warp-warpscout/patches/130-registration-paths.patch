@@ -0,0 +1,100 @@
+package main
+
+import (
+	"context"
+	"crypto/tls"
+	"crypto/x509"
+	"errors"
+	"fmt"
+	"io"
+	"net"
+	"net/http"
+	"os"
+	"time"
+)
+
+const registrationMaxPaths = 4
+const registrationProbeTimeout = 6 * time.Second
+
+var errRegistrationNoEndpoint = errors.New("no reachable endpoint")
+
+type registrationPath struct {
+	name   string
+	client *http.Client
+	close  func()
+}
+
+// Retry network failures only. An API refusal or a bad certificate needs to be
+// reported, rather than masked by repeated account creation.
+func registrationNetworkError(err error) bool {
+	var certificate *tls.CertificateVerificationError
+	var unknown x509.UnknownAuthorityError
+	var hostname x509.HostnameError
+	var invalid x509.CertificateInvalidError
+	if errors.As(err, &certificate) || errors.As(err, &unknown) || errors.As(err, &hostname) || errors.As(err, &invalid) {
+		return false
+	}
+	var network net.Error
+	return errors.As(err, &network) || errors.Is(err, io.EOF) || errors.Is(err, io.ErrUnexpectedEOF) || errors.Is(err, errRegistrationNoEndpoint)
+}
+
+func registrationAPIProbe(ctx context.Context, client *http.Client) error {
+	ctx, cancel := context.WithTimeout(ctx, registrationProbeTimeout)
+	defer cancel()
+	// GET never creates an account. Any HTTP response proves verified HTTPS.
+	request, err := http.NewRequestWithContext(ctx, http.MethodGet, regBaseURL, nil)
+	if err != nil {
+		return err
+	}
+	response, err := client.Do(request)
+	if err != nil {
+		return err
+	}
+	defer response.Body.Close()
+	n, err := io.Copy(io.Discard, io.LimitReader(response.Body, (64<<10)+1))
+	if err != nil {
+		return err
+	}
+	if n > 64<<10 {
+		return errors.New("API probe response too large")
+	}
+	return nil
+}
+
+func registerFromPaths(ctx context.Context, next func(context.Context) (registrationPath, error), existing account) (account, error) {
+	var lastError error
+	for attempt := 0; attempt < registrationMaxPaths && ctx.Err() == nil; attempt++ {
+		path, err := next(ctx)
+		if err != nil {
+			if !errors.Is(err, io.EOF) {
+				lastError = err
+			}
+			break
+		}
+		fmt.Fprintf(os.Stderr, "  checking API HTTPS via %s\n", path.name)
+		err = registrationAPIProbe(ctx, path.client)
+		var result account
+		if err == nil {
+			result, err = mintAccount(ctx, path.client, existing)
+		}
+		path.client.CloseIdleConnections()
+		path.close()
+		if err == nil {
+			return result, nil
+		}
+		lastError = fmt.Errorf("API via %s: %w", path.name, err)
+		// Once POST succeeded, do not create another account just because its
+		// activation request failed. Preserve the partial result for the caller.
+		if result.ID != "" || !registrationNetworkError(err) {
+			return result, lastError
+		}
+		fmt.Fprintf(os.Stderr, "  API via %s failed; trying another endpoint\n", path.name)
+	}
+	if lastError == nil {
+		lastError = ctx.Err()
+	}
+	if lastError == nil {
+		lastError = errRegistrationNoEndpoint
+	}
+	return account{}, lastError
+}
