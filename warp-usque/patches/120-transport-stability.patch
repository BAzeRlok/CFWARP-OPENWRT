diff --git a/api/tunnel_fallback_test.go b/api/tunnel_fallback_test.go
index 1137128c171c772ef592e9fdc585a4f60f6590e8..5c697615038c6813620cdabf59a50cfe7267e67c 100644
--- a/api/tunnel_fallback_test.go
+++ b/api/tunnel_fallback_test.go
@@ -1,10 +1,33 @@
 package api
 
 import (
+	"bytes"
+	"context"
+	"errors"
 	"net"
 	"testing"
+	"time"
 )
 
+type deviceReadResult struct {
+	packet []byte
+	err    error
+}
+
+type fakeTunnelDevice struct {
+	reads chan deviceReadResult
+}
+
+func (f *fakeTunnelDevice) ReadPacket(buf []byte) (int, error) {
+	result := <-f.reads
+	if result.err != nil {
+		return 0, result.err
+	}
+	return copy(buf, result.packet), nil
+}
+
+func (f *fakeTunnelDevice) WritePacket([]byte) error { return nil }
+
 func TestActivateHTTP2Fallback(t *testing.T) {
 	useHTTP2 := false
 	var endpoint net.Addr = &net.UDPAddr{IP: net.IPv4(162, 159, 198, 2), Port: 443}
@@ -36,3 +59,55 @@ func TestActivateHTTP2FallbackRejectsInvalidEndpoint(t *testing.T) {
 		t.Fatal("transport changed after invalid fallback")
 	}
 }
+
+func TestHTTP2FallbackWaitsForRepeatedConnectionFailures(t *testing.T) {
+	useHTTP2 := false
+	var endpoint net.Addr = &net.UDPAddr{IP: net.IPv4(162, 159, 198, 2), Port: 443}
+	fallback := &net.TCPAddr{IP: net.IPv4(162, 159, 198, 2), Port: 443}
+	failures := 0
+
+	for attempt := 1; attempt < autoFallbackConnectFailures; attempt++ {
+		if activateHTTP2FallbackAfterFailure(&useHTTP2, &endpoint, fallback, &failures) {
+			t.Fatalf("fallback activated after only %d failures", attempt)
+		}
+	}
+	if !activateHTTP2FallbackAfterFailure(&useHTTP2, &endpoint, fallback, &failures) {
+		t.Fatal("fallback did not activate at the failure threshold")
+	}
+}
+
+func TestDevicePacketReaderPreservesPacketsAcrossConsumers(t *testing.T) {
+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+	device := &fakeTunnelDevice{reads: make(chan deviceReadResult, 3)}
+	device.reads <- deviceReadResult{packet: []byte{1, 2, 3}}
+	device.reads <- deviceReadResult{packet: []byte{4, 5, 6}}
+	device.reads <- deviceReadResult{err: errors.New("device closed")}
+
+	pool := NewNetBuffer(128)
+	packets := startDevicePacketReader(ctx, device, pool)
+	for _, expected := range [][]byte{{1, 2, 3}, {4, 5, 6}} {
+		select {
+		case packet := <-packets:
+			if packet.err != nil {
+				t.Fatalf("unexpected read error: %v", packet.err)
+			}
+			actual := packet.buf[datagramContextIDHeadroom : datagramContextIDHeadroom+packet.size]
+			if !bytes.Equal(actual, expected) {
+				t.Fatalf("unexpected packet: got %v, want %v", actual, expected)
+			}
+			pool.Put(packet.buf)
+		case <-time.After(time.Second):
+			t.Fatal("timed out waiting for packet")
+		}
+	}
+
+	select {
+	case packet := <-packets:
+		if packet.err == nil || packet.err.Error() != "device closed" {
+			t.Fatalf("unexpected terminal packet: %+v", packet)
+		}
+	case <-time.After(time.Second):
+		t.Fatal("timed out waiting for terminal read error")
+	}
+}
