+func activateHTTP2FallbackAfterFailure(useHTTP2 *bool, endpoint *net.Addr, fallback net.Addr, failures *int) bool {
+	if *failures < autoFallbackConnectFailures {
+		*failures++
+	}
+	if *failures < autoFallbackConnectFailures {
+		return false
+	}
+	if !activateHTTP2Fallback(useHTTP2, endpoint, fallback) {
+		return false
+	}
+	*failures = 0
+	return true
+}
+
+type devicePacket struct {
+	buf  []byte
+	size int
+	err  error
+}
+
+func startDevicePacketReader(ctx context.Context, device TunnelDevice, packetBufferPool *NetBuffer) <-chan *devicePacket {
+	packets := make(chan *devicePacket, devicePacketQueueSize)
+	go func() {
+		defer close(packets)
+		for {
+			buf := packetBufferPool.Get()
+			n, err := device.ReadPacket(buf[datagramContextIDHeadroom:])
+			if err != nil {
+				packetBufferPool.Put(buf)
+				select {
+				case packets <- &devicePacket{err: err}:
+				case <-ctx.Done():
+				}
+				return
+			}
+
+			packet := &devicePacket{buf: buf, size: n}
+			select {
+			case packets <- packet:
+			case <-ctx.Done():
+				packetBufferPool.Put(buf)
+				return
+			}
+		}
+	}()
+	return packets
+}
