diff --git a/api/masque_h2.go b/api/masque_h2.go
new file mode 100644
index 0000000..11461cf
--- /dev/null
+++ b/api/masque_h2.go
@@ -0,0 +1,639 @@
+package api
+
+// Cloudflare's HTTP/2 CONNECT-IP endpoint accepts a non-standard plain
+// CONNECT request. Driving it through net/http can yield a 200 response while
+// leaving the bidirectional request stream without a usable data plane. This
+// implementation writes HTTP/2 frames directly, matching the wire format used
+// by Cloudflare's working clients: plain CONNECT plus cf-connect-proto, with IP
+// packets carried in Capsule Protocol DATAGRAM capsules inside DATA frames.
+
+import (
+	"bytes"
+	"context"
+	"crypto/tls"
+	"encoding/binary"
+	"errors"
+	"fmt"
+	"io"
+	"net"
+	"net/http"
+	"net/url"
+	"sync"
+	"time"
+
+	"github.com/Diniboy1123/usque/internal"
+	"github.com/quic-go/quic-go/quicvarint"
+	"golang.org/x/net/http2"
+	"golang.org/x/net/http2/hpack"
+)
+
+const (
+	h2StreamID              = 1
+	h2DefaultWindowSize     = 65535
+	h2ReceiveWindowSize     = 8 << 20
+	h2DefaultMaxFrameSize   = 16 << 10
+	h2MaxCapsulePayload     = 65535
+	h2DatagramCapsuleType   = 0
+	h2HandshakeTimeout      = 15 * time.Second
+	h2SettingEnablePush     = http2.SettingID(0x2)
+	h2SettingInitialWindow  = http2.SettingID(0x4)
+	h2SettingMaxFrameSize   = http2.SettingID(0x5)
+	minimumIPv4HeaderLength = 20
+	minimumIPv6HeaderLength = 40
+)
+
+type rawH2Conn struct {
+	conn   net.Conn
+	framer *http2.Framer
+
+	writeMu sync.Mutex
+	flowMu  sync.Mutex
+	flowCh  chan struct{}
+
+	connectionWindow  int64
+	streamWindow      int64
+	peerInitialWindow int64
+	maxFrameSize      uint32
+
+	recvCh chan []byte
+	errCh  chan error
+	closed chan struct{}
+
+	closeOnce sync.Once
+}
+
+func connectTunnelHTTP2(ctx context.Context, baseTLSConfig *tls.Config, endpoint *net.TCPAddr, connectURI string) (PacketConnection, *http.Response, error) {
+	if endpoint == nil {
+		return nil, nil, errors.New("missing HTTP/2 endpoint")
+	}
+	u, err := url.Parse(connectURI)
+	if err != nil {
+		return nil, nil, fmt.Errorf("failed to parse connect URI: %w", err)
+	}
+
+	conn, err := persistentTCPDialer().DialContext(ctx, "tcp", endpoint.String())
+	if err != nil {
+		return nil, nil, err
+	}
+
+	// Masked SNI is useful for QUIC, but Cloudflare's HTTP/2 endpoint only has a
+	// reliable data plane with the canonical MASQUE name.
+	tlsConfig := http2TLSConfig(baseTLSConfig)
+	tlsConn := tls.Client(&clientHelloFragmentConn{Conn: conn}, tlsConfig)
+
+	handshakeDeadline := time.Now().Add(h2HandshakeTimeout)
+	if deadline, ok := ctx.Deadline(); ok && deadline.Before(handshakeDeadline) {
+		handshakeDeadline = deadline
+	}
+	_ = conn.SetDeadline(handshakeDeadline)
+	if err := tlsConn.HandshakeContext(ctx); err != nil {
+		_ = conn.Close()
+		return nil, nil, err
+	}
+	if tlsConn.ConnectionState().NegotiatedProtocol != "h2" {
+		_ = conn.Close()
+		return nil, nil, fmt.Errorf("HTTP/2 endpoint negotiated ALPN %q", tlsConn.ConnectionState().NegotiatedProtocol)
+	}
+
+	raw := &rawH2Conn{
+		conn:              tlsConn,
+		framer:            http2.NewFramer(tlsConn, tlsConn),
+		flowCh:            make(chan struct{}, 1),
+		connectionWindow:  h2DefaultWindowSize,
+		streamWindow:      h2DefaultWindowSize,
+		peerInitialWindow: h2DefaultWindowSize,
+		maxFrameSize:      h2DefaultMaxFrameSize,
+		recvCh:            make(chan []byte, 8),
+		errCh:             make(chan error, 1),
+		closed:            make(chan struct{}),
+	}
+
+	if _, err := io.WriteString(tlsConn, http2.ClientPreface); err != nil {
+		_ = raw.Close()
+		return nil, nil, fmt.Errorf("write HTTP/2 preface: %w", err)
+	}
+	if err := raw.framer.WriteSettings(
+		http2.Setting{ID: h2SettingEnablePush, Val: 0},
+		http2.Setting{ID: h2SettingInitialWindow, Val: h2ReceiveWindowSize},
+	); err != nil {
+		_ = raw.Close()
+		return nil, nil, fmt.Errorf("write HTTP/2 settings: %w", err)
+	}
+	if err := raw.framer.WriteWindowUpdate(0, h2ReceiveWindowSize-h2DefaultWindowSize); err != nil {
+		_ = raw.Close()
+		return nil, nil, fmt.Errorf("write HTTP/2 window update: %w", err)
+	}
+
+	status, err := raw.sendConnect(u)
+	if err != nil {
+		_ = raw.Close()
+		return nil, nil, err
+	}
+	if status < 200 || status > 299 {
+		_ = raw.Close()
+		return nil, &http.Response{StatusCode: status, Status: httpStatus(status)}, fmt.Errorf("connect-ip: server responded with %d", status)
+	}
+	_ = conn.SetDeadline(time.Time{})
+	go raw.readLoop()
+
+	return &rawH2PacketConn{stream: raw}, &http.Response{
+		StatusCode: status,
+		Status:     httpStatus(status),
+		Proto:      "HTTP/2.0",
+		ProtoMajor: 2,
+	}, nil
+}
+
+func http2TLSConfig(base *tls.Config) *tls.Config {
+	config := base.Clone()
+	config.ServerName = internal.ConnectSNI
+	config.NextProtos = []string{"h2"}
+	return config
+}
+
+func (c *rawH2Conn) sendConnect(u *url.URL) (int, error) {
+	headerBytes, err := encodeH2ConnectHeaders(u)
+	if err != nil {
+		return 0, err
+	}
+
+	c.writeMu.Lock()
+	err = c.framer.WriteHeaders(http2.HeadersFrameParam{
+		StreamID:      h2StreamID,
+		BlockFragment: headerBytes,
+		EndStream:     false,
+		EndHeaders:    true,
+	})
+	c.writeMu.Unlock()
+	if err != nil {
+		return 0, fmt.Errorf("write CONNECT headers: %w", err)
+	}
+
+	decoder := hpack.NewDecoder(4096, nil)
+	for {
+		frame, err := c.framer.ReadFrame()
+		if err != nil {
+			return 0, fmt.Errorf("read CONNECT response: %w", err)
+		}
+		switch f := frame.(type) {
+		case *http2.SettingsFrame:
+			if !f.IsAck() {
+				if err := c.applySettings(f); err != nil {
+					return 0, err
+				}
+				c.writeMu.Lock()
+				err = c.framer.WriteSettingsAck()
+				c.writeMu.Unlock()
+				if err != nil {
+					return 0, fmt.Errorf("ack HTTP/2 settings: %w", err)
+				}
+			}
+		case *http2.WindowUpdateFrame:
+			c.applyWindowUpdate(f)
+		case *http2.HeadersFrame:
+			if f.StreamID != h2StreamID {
+				continue
+			}
+			block, err := c.readHeaderBlock(f)
+			if err != nil {
+				return 0, err
+			}
+			fields, err := decoder.DecodeFull(block)
+			if err != nil {
+				return 0, fmt.Errorf("decode CONNECT response headers: %w", err)
+			}
+			for _, field := range fields {
+				if field.Name == ":status" {
+					return parseHTTPStatus(field.Value), nil
+				}
+			}
+			return 0, errors.New("CONNECT response has no :status")
+		case *http2.GoAwayFrame:
+			return 0, fmt.Errorf("connect-ip: server sent GOAWAY: %s", f.ErrCode)
+		case *http2.RSTStreamFrame:
+			if f.StreamID == h2StreamID {
+				return 0, fmt.Errorf("connect-ip: stream reset: %s", f.ErrCode)
+			}
+		}
+	}
+}
+
+func encodeH2ConnectHeaders(u *url.URL) ([]byte, error) {
+	var headerBlock bytes.Buffer
+	encoder := hpack.NewEncoder(&headerBlock)
+	fields := []hpack.HeaderField{
+		{Name: ":method", Value: http.MethodConnect},
+		{Name: ":authority", Value: h2Authority(u)},
+		{Name: "capsule-protocol", Value: "?1"},
+		{Name: "user-agent", Value: ""},
+		{Name: "cf-connect-proto", Value: "cf-connect-ip"},
+		{Name: "pq-enabled", Value: "false"},
+	}
+	for _, field := range fields {
+		if err := encoder.WriteField(field); err != nil {
+			return nil, fmt.Errorf("encode CONNECT header %s: %w", field.Name, err)
+		}
+	}
+	return append([]byte(nil), headerBlock.Bytes()...), nil
+}
+
+func (c *rawH2Conn) readHeaderBlock(first *http2.HeadersFrame) ([]byte, error) {
+	block := append([]byte(nil), first.HeaderBlockFragment()...)
+	if first.HeadersEnded() {
+		return block, nil
+	}
+	for {
+		frame, err := c.framer.ReadFrame()
+		if err != nil {
+			return nil, fmt.Errorf("read CONNECT continuation: %w", err)
+		}
+		continuation, ok := frame.(*http2.ContinuationFrame)
+		if !ok || continuation.StreamID != first.StreamID {
+			return nil, errors.New("invalid HTTP/2 header continuation")
+		}
+		block = append(block, continuation.HeaderBlockFragment()...)
+		if continuation.HeadersEnded() {
+			return block, nil
+		}
+	}
+}
+
+func (c *rawH2Conn) readLoop() {
+	defer close(c.recvCh)
+	for {
+		frame, err := c.framer.ReadFrame()
+		if err != nil {
+			c.setErr(err)
+			return
+		}
+		switch f := frame.(type) {
+		case *http2.DataFrame:
+			if f.StreamID != h2StreamID {
+				continue
+			}
+			data := f.Data()
+			if len(data) > 0 {
+				packetData := append([]byte(nil), data...)
+				c.writeMu.Lock()
+				err := c.framer.WriteWindowUpdate(0, uint32(len(data)))
+				if err == nil {
+					err = c.framer.WriteWindowUpdate(h2StreamID, uint32(len(data)))
+				}
+				c.writeMu.Unlock()
+				if err != nil {
+					c.setErr(err)
+					return
+				}
+				select {
+				case c.recvCh <- packetData:
+				case <-c.closed:
+					return
+				}
+			}
+			if f.StreamEnded() {
+				c.setErr(io.EOF)
+				return
+			}
+		case *http2.SettingsFrame:
+			if !f.IsAck() {
+				if err := c.applySettings(f); err != nil {
+					c.setErr(err)
+					return
+				}
+				c.writeMu.Lock()
+				err := c.framer.WriteSettingsAck()
+				c.writeMu.Unlock()
+				if err != nil {
+					c.setErr(err)
+					return
+				}
+			}
+		case *http2.WindowUpdateFrame:
+			c.applyWindowUpdate(f)
+		case *http2.PingFrame:
+			if !f.IsAck() {
+				c.writeMu.Lock()
+				err := c.framer.WritePing(true, f.Data)
+				c.writeMu.Unlock()
+				if err != nil {
+					c.setErr(err)
+					return
+				}
+			}
+		case *http2.GoAwayFrame:
+			c.setErr(fmt.Errorf("connect-ip: GOAWAY %s", f.ErrCode))
+			return
+		case *http2.RSTStreamFrame:
+			if f.StreamID == h2StreamID {
+				c.setErr(fmt.Errorf("connect-ip: RST_STREAM %s", f.ErrCode))
+				return
+			}
+		}
+	}
+}
+
+func (c *rawH2Conn) applySettings(frame *http2.SettingsFrame) error {
+	var settingsErr error
+	err := frame.ForeachSetting(func(setting http2.Setting) error {
+		switch setting.ID {
+		case h2SettingInitialWindow:
+			if setting.Val > (1<<31)-1 {
+				return errors.New("invalid HTTP/2 initial window")
+			}
+			c.flowMu.Lock()
+			delta := int64(setting.Val) - c.peerInitialWindow
+			c.streamWindow += delta
+			c.peerInitialWindow = int64(setting.Val)
+			c.signalFlowLocked()
+			c.flowMu.Unlock()
+		case h2SettingMaxFrameSize:
+			if setting.Val < h2DefaultMaxFrameSize || setting.Val > (1<<24)-1 {
+				return errors.New("invalid HTTP/2 max frame size")
+			}
+			c.flowMu.Lock()
+			c.maxFrameSize = setting.Val
+			c.flowMu.Unlock()
+		}
+		return nil
+	})
+	if err != nil {
+		settingsErr = fmt.Errorf("apply HTTP/2 settings: %w", err)
+	}
+	return settingsErr
+}
+
+func (c *rawH2Conn) applyWindowUpdate(frame *http2.WindowUpdateFrame) {
+	c.flowMu.Lock()
+	if frame.StreamID == 0 {
+		c.connectionWindow += int64(frame.Increment)
+	} else if frame.StreamID == h2StreamID {
+		c.streamWindow += int64(frame.Increment)
+	}
+	c.signalFlowLocked()
+	c.flowMu.Unlock()
+}
+
+func (c *rawH2Conn) writeData(data []byte) error {
+	for len(data) > 0 {
+		chunkSize, err := c.reserveSendWindow(len(data))
+		if err != nil {
+			return err
+		}
+		c.writeMu.Lock()
+		err = c.framer.WriteData(h2StreamID, false, data[:chunkSize])
+		c.writeMu.Unlock()
+		if err != nil {
+			return err
+		}
+		data = data[chunkSize:]
+	}
+	return nil
+}
+
+func (c *rawH2Conn) reserveSendWindow(want int) (int, error) {
+	for {
+		c.flowMu.Lock()
+		available := c.connectionWindow
+		if c.streamWindow < available {
+			available = c.streamWindow
+		}
+		if int64(c.maxFrameSize) < available {
+			available = int64(c.maxFrameSize)
+		}
+		if int64(want) < available {
+			available = int64(want)
+		}
+		if available > 0 {
+			c.connectionWindow -= available
+			c.streamWindow -= available
+			c.flowMu.Unlock()
+			return int(available), nil
+		}
+		c.flowMu.Unlock()
+
+		select {
+		case <-c.flowCh:
+		case <-c.closed:
+			return 0, net.ErrClosed
+		}
+	}
+}
+
+func (c *rawH2Conn) signalFlowLocked() {
+	select {
+	case c.flowCh <- struct{}{}:
+	default:
+	}
+}
+
+func (c *rawH2Conn) setErr(err error) {
+	select {
+	case c.errCh <- err:
+	default:
+	}
+}
+
+func (c *rawH2Conn) Close() error {
+	c.closeOnce.Do(func() {
+		close(c.closed)
+		c.flowMu.Lock()
+		c.signalFlowLocked()
+		c.flowMu.Unlock()
+		_ = c.conn.SetDeadline(time.Now())
+		_ = c.conn.Close()
+	})
+	return nil
+}
+
+type rawH2PacketConn struct {
+	stream *rawH2Conn
+
+	readBuf   []byte
+	writeBuf  []byte
+	closeOnce sync.Once
+}
+
+func (c *rawH2PacketConn) ReadPacketZeroCopy(_ bool) ([]byte, error) {
+	for {
+		if capsuleType, payload, consumed, ok, err := parseH2Capsule(c.readBuf); err != nil {
+			return nil, err
+		} else if ok {
+			packet := append([]byte(nil), payload...)
+			c.readBuf = c.readBuf[consumed:]
+			if capsuleType != h2DatagramCapsuleType {
+				continue
+			}
+			if err := validateIncomingIPPacket(packet); err != nil {
+				continue
+			}
+			return packet, nil
+		}
+
+		chunk, ok := <-c.stream.recvCh
+		if !ok {
+			select {
+			case err := <-c.stream.errCh:
+				return nil, err
+			default:
+				return nil, io.EOF
+			}
+		}
+		c.readBuf = append(c.readBuf, chunk...)
+	}
+}
+
+func (c *rawH2PacketConn) WritePacketBuffer(buf []byte, packetOffset, packetLen int) ([]byte, error) {
+	if packetOffset < 0 || packetLen < 0 || packetOffset+packetLen > len(buf) {
+		return nil, errors.New("connect-ip: invalid packet bounds")
+	}
+	packet := buf[packetOffset : packetOffset+packetLen]
+	if err := prepareOutgoingIPPacket(packet); err != nil {
+		return nil, nil
+	}
+
+	need := quicvarint.Len(h2DatagramCapsuleType) + quicvarint.Len(uint64(len(packet))) + len(packet)
+	if cap(c.writeBuf) < need {
+		c.writeBuf = make([]byte, 0, need)
+	}
+	frame := c.writeBuf[:0]
+	frame = quicvarint.Append(frame, h2DatagramCapsuleType)
+	frame = quicvarint.Append(frame, uint64(len(packet)))
+	frame = append(frame, packet...)
+	c.writeBuf = frame
+	return nil, c.stream.writeData(frame)
+}
+
+func (c *rawH2PacketConn) Close() error {
+	c.closeOnce.Do(func() { _ = c.stream.Close() })
+	return nil
+}
+
+func parseH2Capsule(buf []byte) (capsuleType uint64, payload []byte, consumed int, ok bool, err error) {
+	capsuleType, typeLen, ok := parseH2Varint(buf)
+	if !ok {
+		return 0, nil, 0, false, nil
+	}
+	payloadLen, payloadLenLen, ok := parseH2Varint(buf[typeLen:])
+	if !ok {
+		return 0, nil, 0, false, nil
+	}
+	if payloadLen > h2MaxCapsulePayload {
+		return 0, nil, 0, false, errors.New("connect-ip: capsule payload too large")
+	}
+	headerLen := typeLen + payloadLenLen
+	totalLen := headerLen + int(payloadLen)
+	if len(buf) < totalLen {
+		return 0, nil, 0, false, nil
+	}
+	return capsuleType, buf[headerLen:totalLen], totalLen, true, nil
+}
+
+func parseH2Varint(buf []byte) (uint64, int, bool) {
+	if len(buf) == 0 {
+		return 0, 0, false
+	}
+	length := 1 << (buf[0] >> 6)
+	if len(buf) < length {
+		return 0, 0, false
+	}
+	value := uint64(buf[0] & 0x3f)
+	for i := 1; i < length; i++ {
+		value = value<<8 | uint64(buf[i])
+	}
+	return value, length, true
+}
+
+func prepareOutgoingIPPacket(packet []byte) error {
+	if len(packet) == 0 {
+		return errors.New("connect-ip: empty packet")
+	}
+	switch packet[0] >> 4 {
+	case 4:
+		if len(packet) < minimumIPv4HeaderLength {
+			return errors.New("connect-ip: IPv4 packet too short")
+		}
+		headerLength := int(packet[0]&0x0f) * 4
+		if headerLength < minimumIPv4HeaderLength || headerLength > len(packet) {
+			return errors.New("connect-ip: invalid IPv4 header length")
+		}
+		if packet[8] <= 1 {
+			return errors.New("connect-ip: IPv4 TTL too small")
+		}
+		packet[8]--
+		packet[10], packet[11] = 0, 0
+		binary.BigEndian.PutUint16(packet[10:12], ipv4HeaderChecksum(packet[:headerLength]))
+	case 6:
+		if len(packet) < minimumIPv6HeaderLength {
+			return errors.New("connect-ip: IPv6 packet too short")
+		}
+		if packet[7] <= 1 {
+			return errors.New("connect-ip: IPv6 hop limit too small")
+		}
+		packet[7]--
+	default:
+		return errors.New("connect-ip: unknown IP version")
+	}
+	return nil
+}
+
+func validateIncomingIPPacket(packet []byte) error {
+	if len(packet) == 0 {
+		return errors.New("connect-ip: empty packet")
+	}
+	switch packet[0] >> 4 {
+	case 4:
+		if len(packet) < minimumIPv4HeaderLength {
+			return errors.New("connect-ip: IPv4 packet too short")
+		}
+	case 6:
+		if len(packet) < minimumIPv6HeaderLength {
+			return errors.New("connect-ip: IPv6 packet too short")
+		}
+	default:
+		return errors.New("connect-ip: unknown IP version")
+	}
+	return nil
+}
+
+func ipv4HeaderChecksum(header []byte) uint16 {
+	var sum uint32
+	for i := 0; i+1 < len(header); i += 2 {
+		sum += uint32(binary.BigEndian.Uint16(header[i : i+2]))
+	}
+	if len(header)%2 != 0 {
+		sum += uint32(header[len(header)-1]) << 8
+	}
+	for sum>>16 != 0 {
+		sum = (sum & 0xffff) + (sum >> 16)
+	}
+	return ^uint16(sum)
+}
+
+func h2Authority(u *url.URL) string {
+	if u.Port() != "" {
+		return u.Host
+	}
+	if u.Hostname() == "" {
+		return u.Host
+	}
+	return net.JoinHostPort(u.Hostname(), "443")
+}
+
+func parseHTTPStatus(value string) int {
+	status := 0
+	for _, r := range value {
+		if r < '0' || r > '9' {
+			return 0
+		}
+		status = status*10 + int(r-'0')
+	}
+	return status
+}
+
+func httpStatus(status int) string {
+	text := http.StatusText(status)
+	if text == "" {
+		return fmt.Sprintf("%d", status)
+	}
+	return fmt.Sprintf("%d %s", status, text)
+}
