+package api
+
+import (
+	"crypto/tls"
+	"encoding/binary"
+	"net/url"
+	"testing"
+
+	"github.com/quic-go/quic-go/quicvarint"
+	"golang.org/x/net/http2/hpack"
+)
+
+func TestHTTP2TLSConfigUsesCanonicalSNIWithoutMutatingQUIC(t *testing.T) {
+	base := &tls.Config{ServerName: "ozon.ru", NextProtos: []string{"h3"}}
+	h2 := http2TLSConfig(base)
+	if h2.ServerName != "consumer-masque.cloudflareclient.com" {
+		t.Fatalf("HTTP/2 SNI: got %q", h2.ServerName)
+	}
+	if len(h2.NextProtos) != 1 || h2.NextProtos[0] != "h2" {
+		t.Fatalf("HTTP/2 ALPN: %v", h2.NextProtos)
+	}
+	if base.ServerName != "ozon.ru" || len(base.NextProtos) != 1 || base.NextProtos[0] != "h3" {
+		t.Fatalf("base QUIC config was mutated: SNI=%q ALPN=%v", base.ServerName, base.NextProtos)
+	}
+}
+
+func TestEncodeH2ConnectHeadersUsesCloudflarePlainConnect(t *testing.T) {
+	u, err := url.Parse("https://cloudflareaccess.com")
+	if err != nil {
+		t.Fatal(err)
+	}
+	block, err := encodeH2ConnectHeaders(u)
+	if err != nil {
+		t.Fatal(err)
+	}
+	fields, err := hpack.NewDecoder(4096, nil).DecodeFull(block)
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	got := make(map[string]string, len(fields))
+	for _, field := range fields {
+		got[field.Name] = field.Value
+	}
+	for name, expected := range map[string]string{
+		":method":          "CONNECT",
+		":authority":       "cloudflareaccess.com:443",
+		"capsule-protocol": "?1",
+		"cf-connect-proto": "cf-connect-ip",
+		"pq-enabled":       "false",
+	} {
+		if got[name] != expected {
+			t.Fatalf("header %s: got %q, want %q", name, got[name], expected)
+		}
+	}
+	for _, forbidden := range []string{":scheme", ":path", ":protocol"} {
+		if _, exists := got[forbidden]; exists {
+			t.Fatalf("plain CONNECT must not include %s", forbidden)
+		}
+	}
+}
+
+func TestParseH2CapsuleWaitsForCompletePayload(t *testing.T) {
+	payload := []byte{0x45, 0, 0, 20}
+	frame := quicvarint.Append(nil, h2DatagramCapsuleType)
+	frame = quicvarint.Append(frame, uint64(len(payload)))
+	frame = append(frame, payload...)
+
+	if _, _, _, ok, err := parseH2Capsule(frame[:len(frame)-1]); err != nil || ok {
+		t.Fatalf("partial capsule: ok=%v err=%v", ok, err)
+	}
+	typ, got, consumed, ok, err := parseH2Capsule(frame)
+	if err != nil || !ok {
+		t.Fatalf("complete capsule: ok=%v err=%v", ok, err)
+	}
+	if typ != h2DatagramCapsuleType || consumed != len(frame) || string(got) != string(payload) {
+		t.Fatalf("unexpected parsed capsule: type=%d consumed=%d payload=%x", typ, consumed, got)
+	}
+}
+
+func TestPrepareOutgoingIPv4DecrementsTTLAndRepairsChecksum(t *testing.T) {
+	packet := make([]byte, minimumIPv4HeaderLength)
+	packet[0] = 0x45
+	binary.BigEndian.PutUint16(packet[2:4], uint16(len(packet)))
+	packet[8] = 64
+	packet[9] = 1
+	copy(packet[12:16], []byte{172, 16, 0, 2})
+	copy(packet[16:20], []byte{1, 1, 1, 1})
+	binary.BigEndian.PutUint16(packet[10:12], ipv4HeaderChecksum(packet))
+
+	if err := prepareOutgoingIPPacket(packet); err != nil {
+		t.Fatal(err)
+	}
+	if packet[8] != 63 {
+		t.Fatalf("TTL: got %d, want 63", packet[8])
+	}
+	if checksum := ipv4HeaderChecksum(packet); checksum != 0 {
+		t.Fatalf("invalid IPv4 checksum after TTL update: %#x", checksum)
+	}
+}
