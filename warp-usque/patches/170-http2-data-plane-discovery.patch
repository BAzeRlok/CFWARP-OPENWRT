diff --git a/api/masque_h2_probe.go b/api/masque_h2_probe.go
new file mode 100644
index 0000000..ce1dba4
--- /dev/null
+++ b/api/masque_h2_probe.go
@@ -0,0 +1,253 @@
+package api
+
+import (
+	"context"
+	"crypto/tls"
+	"encoding/binary"
+	"errors"
+	"fmt"
+	"log"
+	"net"
+	"net/http"
+	"time"
+
+	"github.com/Diniboy1123/usque/internal"
+	"github.com/quic-go/quic-go/http3"
+)
+
+const (
+	h2ProbeDestination      = "1.1.1.1"
+	h2ProbeAttempts         = 3
+	h2ProbeRepliesRequired  = 2
+	h2CandidateTimeout      = 4 * time.Second
+	h2CandidateParallelism  = 10
+	h2ProbeICMPEchoReply    = 0
+	h2ProbeICMPUnreachable  = 3
+	h2ProbeICMPTimeExceeded = 11
+	h2ProbeICMPIdentifier   = 0x5741
+	h2ProbePayloadLength    = 16
+)
+
+var h2ProbeDestinationIP = net.IPv4(1, 1, 1, 1).To4()
+
+type h2CandidateResult struct {
+	endpoint net.Addr
+	conn     PacketConnection
+	response *http.Response
+	err      error
+}
+
+func connectSupervisorTunnel(ctx context.Context, cfg MaintainTunnelConfig, endpoint net.Addr, useHTTP2 bool) (*net.UDPConn, *http3.Transport, PacketConnection, *http.Response, net.Addr, error) {
+	if !useHTTP2 {
+		udpConn, transport, conn, response, err := ConnectTunnel(
+			ctx,
+			cfg.TLSConfig,
+			internal.DefaultQuicConfig(cfg.KeepalivePeriod, cfg.InitialPacketSize),
+			internal.ConnectURI,
+			endpoint,
+			false,
+		)
+		return udpConn, transport, conn, response, endpoint, err
+	}
+
+	candidates := make([]net.Addr, 0, len(cfg.HTTP2Endpoints)+1)
+	candidates = append(candidates, endpoint)
+	candidates = append(candidates, cfg.HTTP2Endpoints...)
+	conn, response, selected, err := connectVerifiedHTTP2(ctx, cfg.TLSConfig, internal.ConnectURI, candidates, cfg.HTTP2ProbeIPv4)
+	return nil, nil, conn, response, selected, err
+}
+
+// connectVerifiedHTTP2 tests the configured endpoint first and only fans out
+// across the sampled Cloudflare pool if that endpoint accepts CONNECT but does
+// not carry real IP traffic. The probe requires multiple echo replies, which
+// rejects the observed failure mode where one packet passes and the endpoint
+// immediately returns an administrative ICMP error.
+func connectVerifiedHTTP2(ctx context.Context, tlsConfig *tls.Config, connectURI string, candidates []net.Addr, sourceIPv4 net.IP) (PacketConnection, *http.Response, net.Addr, error) {
+	ordered := uniqueHTTPEndpoints(candidates)
+	if len(ordered) == 0 {
+		return nil, nil, nil, errors.New("no HTTP/2 endpoints to verify")
+	}
+	if sourceIPv4.To4() == nil {
+		return nil, nil, nil, errors.New("HTTP/2 data-plane verification requires a valid tunnel IPv4 address")
+	}
+
+	first, attempts := runHTTP2CandidateBatch(ctx, tlsConfig, connectURI, ordered[:1], sourceIPv4)
+	if first.err == nil {
+		return first.conn, first.response, first.endpoint, nil
+	}
+	lastErr := first.err
+	log.Printf("HTTP/2 endpoint %s failed data-plane verification: %v; scanning %d alternate endpoint/port pairs", ordered[0], first.err, len(ordered)-1)
+
+	for start := 1; start < len(ordered); start += h2CandidateParallelism {
+		end := start + h2CandidateParallelism
+		if end > len(ordered) {
+			end = len(ordered)
+		}
+		winner, tried := runHTTP2CandidateBatch(ctx, tlsConfig, connectURI, ordered[start:end], sourceIPv4)
+		attempts += tried
+		if winner.err == nil {
+			log.Printf("Selected verified HTTP/2 endpoint %s after %d candidates", winner.endpoint, attempts)
+			return winner.conn, winner.response, winner.endpoint, nil
+		}
+		lastErr = winner.err
+		if ctx.Err() != nil {
+			return nil, nil, nil, context.Cause(ctx)
+		}
+	}
+
+	return nil, nil, nil, fmt.Errorf("no HTTP/2 endpoint passed the IP data-plane probe after %d candidates: %w", attempts, lastErr)
+}
+
+func runHTTP2CandidateBatch(ctx context.Context, tlsConfig *tls.Config, connectURI string, candidates []net.Addr, sourceIPv4 net.IP) (h2CandidateResult, int) {
+	batchCtx, cancel := context.WithCancel(ctx)
+	defer cancel()
+	results := make(chan h2CandidateResult, len(candidates))
+	for _, endpoint := range candidates {
+		go func(endpoint net.Addr) {
+			results <- probeHTTP2Candidate(batchCtx, tlsConfig, connectURI, endpoint, sourceIPv4)
+		}(endpoint)
+	}
+
+	winner := h2CandidateResult{err: errors.New("HTTP/2 candidate batch failed")}
+	for range candidates {
+		result := <-results
+		if result.err == nil && winner.conn == nil {
+			winner = result
+			cancel()
+			continue
+		}
+		if result.conn != nil {
+			_ = result.conn.Close()
+		}
+		if winner.conn == nil && result.err != nil {
+			winner.err = result.err
+		}
+	}
+	return winner, len(candidates)
+}
+
+func probeHTTP2Candidate(ctx context.Context, tlsConfig *tls.Config, connectURI string, endpoint net.Addr, sourceIPv4 net.IP) h2CandidateResult {
+	result := h2CandidateResult{endpoint: endpoint}
+	tcpEndpoint, ok := endpoint.(*net.TCPAddr)
+	if !ok || tcpEndpoint == nil {
+		result.err = fmt.Errorf("HTTP/2 candidate %T is not a TCP endpoint", endpoint)
+		return result
+	}
+
+	attemptCtx, cancel := context.WithTimeout(ctx, h2CandidateTimeout)
+	defer cancel()
+	result.conn, result.response, result.err = connectTunnelHTTP2(attemptCtx, tlsConfig, tcpEndpoint, connectURI)
+	if result.err != nil {
+		return result
+	}
+	if result.response == nil || result.response.StatusCode != http.StatusOK {
+		result.err = fmt.Errorf("CONNECT returned %v", result.response)
+		return result
+	}
+	if result.err = verifyHTTP2DataPlane(attemptCtx, result.conn, sourceIPv4); result.err != nil {
+		return result
+	}
+	return result
+}
+
+func verifyHTTP2DataPlane(ctx context.Context, conn PacketConnection, sourceIPv4 net.IP) error {
+	raw, ok := conn.(*rawH2PacketConn)
+	if !ok {
+		return fmt.Errorf("unsupported HTTP/2 packet connection %T", conn)
+	}
+	for sequence := uint16(1); sequence <= h2ProbeAttempts; sequence++ {
+		packet := buildHTTP2ProbePacket(sourceIPv4, h2ProbeICMPIdentifier, sequence)
+		buffer := make([]byte, len(packet)+datagramContextIDHeadroom)
+		copy(buffer[datagramContextIDHeadroom:], packet)
+		if _, err := conn.WritePacketBuffer(buffer, datagramContextIDHeadroom, len(packet)); err != nil {
+			return fmt.Errorf("send probe: %w", err)
+		}
+	}
+
+	replies := 0
+	for replies < h2ProbeRepliesRequired {
+		packet, err := raw.readPacket(ctx)
+		if err != nil {
+			return fmt.Errorf("receive probe (%d/%d replies): %w", replies, h2ProbeRepliesRequired, err)
+		}
+		matched, failure := classifyHTTP2ProbePacket(packet, sourceIPv4, h2ProbeICMPIdentifier)
+		if failure != nil {
+			return failure
+		}
+		if matched {
+			replies++
+		}
+	}
+	return nil
+}
+
+func buildHTTP2ProbePacket(sourceIPv4 net.IP, identifier, sequence uint16) []byte {
+	packet := make([]byte, minimumIPv4HeaderLength+8+h2ProbePayloadLength)
+	packet[0] = 0x45
+	binary.BigEndian.PutUint16(packet[2:4], uint16(len(packet)))
+	binary.BigEndian.PutUint16(packet[4:6], sequence)
+	packet[6] = 0x40
+	packet[8] = 64
+	packet[9] = 1
+	copy(packet[12:16], sourceIPv4.To4())
+	copy(packet[16:20], h2ProbeDestinationIP)
+	binary.BigEndian.PutUint16(packet[10:12], ipv4HeaderChecksum(packet[:minimumIPv4HeaderLength]))
+
+	icmp := packet[minimumIPv4HeaderLength:]
+	icmp[0] = 8
+	binary.BigEndian.PutUint16(icmp[4:6], identifier)
+	binary.BigEndian.PutUint16(icmp[6:8], sequence)
+	copy(icmp[8:], []byte("CFWARP-H2-PROBE"))
+	binary.BigEndian.PutUint16(icmp[2:4], internetChecksum(icmp))
+	return packet
+}
+
+func classifyHTTP2ProbePacket(packet []byte, sourceIPv4 net.IP, identifier uint16) (bool, error) {
+	if len(packet) < minimumIPv4HeaderLength || packet[0]>>4 != 4 || packet[9] != 1 {
+		return false, nil
+	}
+	headerLength := int(packet[0]&0x0f) * 4
+	if headerLength < minimumIPv4HeaderLength || len(packet) < headerLength+8 {
+		return false, nil
+	}
+	icmp := packet[headerLength:]
+	if icmp[0] == h2ProbeICMPEchoReply && icmp[1] == 0 && binary.BigEndian.Uint16(icmp[4:6]) == identifier && net.IP(packet[12:16]).Equal(h2ProbeDestinationIP) && net.IP(packet[16:20]).Equal(sourceIPv4.To4()) {
+		return true, nil
+	}
+	if icmp[0] == h2ProbeICMPUnreachable || icmp[0] == h2ProbeICMPTimeExceeded {
+		return false, fmt.Errorf("HTTP/2 data plane returned ICMP type %d code %d", icmp[0], icmp[1])
+	}
+	return false, nil
+}
+
+func internetChecksum(data []byte) uint16 {
+	var sum uint32
+	for len(data) >= 2 {
+		sum += uint32(binary.BigEndian.Uint16(data[:2]))
+		data = data[2:]
+	}
+	if len(data) == 1 {
+		sum += uint32(data[0]) << 8
+	}
+	for sum>>16 != 0 {
+		sum = (sum & 0xffff) + (sum >> 16)
+	}
+	return ^uint16(sum)
+}
+
+func uniqueHTTPEndpoints(candidates []net.Addr) []net.Addr {
+	result := make([]net.Addr, 0, len(candidates))
+	seen := make(map[string]struct{}, len(candidates))
+	for _, candidate := range candidates {
+		if candidate == nil {
+			continue
+		}
+		key := candidate.Network() + ":" + candidate.String()
+		if _, exists := seen[key]; exists {
+			continue
+		}
+		seen[key] = struct{}{}
+		result = append(result, candidate)
+	}
+	return result
+}
