diff --git a/config/endpoints_h2_pool.go b/config/endpoints_h2_pool.go
new file mode 100644
index 0000000..b971b3e
--- /dev/null
+++ b/config/endpoints_h2_pool.go
@@ -0,0 +1,69 @@
+package config
+
+import (
+	"hash/fnv"
+	"math/rand"
+	"net"
+	"time"
+)
+
+var cloudflareHTTP2Ports = []int{443, 500, 1701, 4500, 4443, 8443, 8095}
+
+const http2SamplesPerIPv4Pool = 5
+
+// HTTP2EndpointCandidates returns the configured endpoint first, followed by a
+// small randomized sample from Cloudflare's two HTTP/2 anycast pools and all
+// known MASQUE ports. A successful CONNECT is not sufficient for this service:
+// some endpoint/port pairs accept the session but silently drop the IP data
+// plane, so the caller must verify candidates from the returned list.
+func HTTP2EndpointCandidates(primary net.Addr, useIPv6 bool, deviceID string) []net.Addr {
+	if primary == nil || useIPv6 {
+		return []net.Addr{primary}
+	}
+	primaryTCP, ok := primary.(*net.TCPAddr)
+	if !ok || primaryTCP.IP.To4() == nil {
+		return []net.Addr{primary}
+	}
+
+	h := fnv.New64a()
+	_, _ = h.Write([]byte(deviceID))
+	seed := int64(h.Sum64() ^ uint64(time.Now().UnixNano()))
+	return http2IPv4EndpointCandidates(primaryTCP, seed)
+}
+
+func http2IPv4EndpointCandidates(primary *net.TCPAddr, seed int64) []net.Addr {
+	result := make([]net.Addr, 0, 1+2*http2SamplesPerIPv4Pool*len(cloudflareHTTP2Ports))
+	seen := make(map[string]struct{}, cap(result))
+	appendCandidate := func(ip net.IP, port int) {
+		candidate := &net.TCPAddr{IP: append(net.IP(nil), ip...), Port: port}
+		key := candidate.String()
+		if _, exists := seen[key]; exists {
+			return
+		}
+		seen[key] = struct{}{}
+		result = append(result, candidate)
+	}
+
+	appendCandidate(primary.IP, primary.Port)
+	rng := rand.New(rand.NewSource(seed))
+	for _, thirdOctet := range []byte{198, 199} {
+		for _, hostOffset := range rng.Perm(254)[:http2SamplesPerIPv4Pool] {
+			ip := net.IPv4(162, 159, thirdOctet, byte(hostOffset+1))
+			for _, port := range preferredHTTP2Ports(primary.Port) {
+				appendCandidate(ip, port)
+			}
+		}
+	}
+	return result
+}
+
+func preferredHTTP2Ports(primary int) []int {
+	ports := make([]int, 0, len(cloudflareHTTP2Ports)+1)
+	ports = append(ports, primary)
+	for _, port := range cloudflareHTTP2Ports {
+		if port != primary {
+			ports = append(ports, port)
+		}
+	}
+	return ports
+}
