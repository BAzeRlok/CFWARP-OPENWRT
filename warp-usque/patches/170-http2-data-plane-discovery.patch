@@ -0,0 +1,44 @@
+package api
+
+import (
+	"encoding/binary"
+	"net"
+	"testing"
+)
+
+func TestHTTP2ProbePacketHasValidChecksums(t *testing.T) {
+	packet := buildHTTP2ProbePacket(net.IPv4(172, 16, 0, 2), h2ProbeICMPIdentifier, 2)
+	if got := internetChecksum(packet[:minimumIPv4HeaderLength]); got != 0 {
+		t.Fatalf("IPv4 checksum = %#x", got)
+	}
+	if got := internetChecksum(packet[minimumIPv4HeaderLength:]); got != 0 {
+		t.Fatalf("ICMP checksum = %#x", got)
+	}
+}
+
+func TestClassifyHTTP2ProbeReplyAndAdministrativeError(t *testing.T) {
+	source := net.IPv4(172, 16, 0, 2)
+	reply := buildHTTP2ProbePacket(h2ProbeDestinationIP, h2ProbeICMPIdentifier, 1)
+	copy(reply[16:20], source.To4())
+	reply[minimumIPv4HeaderLength] = h2ProbeICMPEchoReply
+	reply[10], reply[11] = 0, 0
+	binary.BigEndian.PutUint16(reply[10:12], ipv4HeaderChecksum(reply[:minimumIPv4HeaderLength]))
+	if matched, err := classifyHTTP2ProbePacket(reply, source, h2ProbeICMPIdentifier); !matched || err != nil {
+		t.Fatalf("echo reply: matched=%v err=%v", matched, err)
+	}
+
+	reply[minimumIPv4HeaderLength] = h2ProbeICMPUnreachable
+	reply[minimumIPv4HeaderLength+1] = 13
+	if matched, err := classifyHTTP2ProbePacket(reply, source, h2ProbeICMPIdentifier); matched || err == nil {
+		t.Fatalf("administrative reject: matched=%v err=%v", matched, err)
+	}
+}
+
+func TestUniqueHTTPEndpointsPreservesOrder(t *testing.T) {
+	one := &net.TCPAddr{IP: net.IPv4(162, 159, 198, 2), Port: 443}
+	two := &net.TCPAddr{IP: net.IPv4(162, 159, 199, 2), Port: 443}
+	got := uniqueHTTPEndpoints([]net.Addr{one, one, nil, two})
+	if len(got) != 2 || got[0].String() != one.String() || got[1].String() != two.String() {
+		t.Fatalf("unexpected endpoints: %v", got)
+	}
+}
