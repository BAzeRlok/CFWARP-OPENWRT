@@ -0,0 +1,44 @@
+package config
+
+import (
+	"net"
+	"testing"
+)
+
+func TestHTTP2IPv4CandidatesKeepPrimaryAndCoverBothPools(t *testing.T) {
+	primary := &net.TCPAddr{IP: net.IPv4(162, 159, 198, 2), Port: 443}
+	candidates := http2IPv4EndpointCandidates(primary, 42)
+	maximum := 1 + 2*http2SamplesPerIPv4Pool*len(cloudflareHTTP2Ports)
+	if len(candidates) < maximum-1 || len(candidates) > maximum {
+		t.Fatalf("candidate count: got %d", len(candidates))
+	}
+	if candidates[0].String() != primary.String() {
+		t.Fatalf("first candidate: got %s, want %s", candidates[0], primary)
+	}
+
+	seen := make(map[string]bool, len(candidates))
+	pools := map[byte]bool{}
+	for _, endpoint := range candidates {
+		if seen[endpoint.String()] {
+			t.Fatalf("duplicate endpoint %s", endpoint)
+		}
+		seen[endpoint.String()] = true
+		tcp := endpoint.(*net.TCPAddr)
+		v4 := tcp.IP.To4()
+		if v4 == nil || v4[0] != 162 || v4[1] != 159 || (v4[2] != 198 && v4[2] != 199) {
+			t.Fatalf("endpoint outside Cloudflare HTTP/2 pools: %s", endpoint)
+		}
+		pools[v4[2]] = true
+	}
+	if !pools[198] || !pools[199] {
+		t.Fatalf("both pools were not sampled: %v", pools)
+	}
+}
+
+func TestHTTP2IPv6CandidatesStayPinned(t *testing.T) {
+	primary := &net.TCPAddr{IP: net.ParseIP("2606:4700:103::2"), Port: 443}
+	candidates := HTTP2EndpointCandidates(primary, true, "device")
+	if len(candidates) != 1 || candidates[0].String() != primary.String() {
+		t.Fatalf("unexpected IPv6 candidates: %v", candidates)
+	}
+}
