-	// devicePacketQueueSize keeps a small amount of outbound traffic while the
-	// MASQUE transport reconnects. A single persistent TUN reader prevents stale
-	// readers from stealing packets after a reconnect.
-	devicePacketQueueSize = 64
+	// devicePacketQueueSize keeps exactly the packet which triggered a reconnect.
+	// quic-go already has its own bounded DATAGRAM queue. Buffering another large
+	// FIFO here creates seconds of head-of-line delay when the outer QUIC path is
+	// lossy or congested. Let the TUN qdisc provide backpressure and fair queueing
+	// instead of draining it into userspace. A single persistent TUN reader still
+	// prevents stale readers from stealing packets across reconnects.
+	devicePacketQueueSize = 1
 	// autoFallbackConnectFailures avoids abandoning a working QUIC path after a
 	// normal remote idle disconnect or one transient handshake failure.
 	autoFallbackConnectFailures = 3
