+	// Chrome fingerprints advertise HTTP/2 by default. net/http cannot detect
+	// the negotiated protocol on a custom uTLS connection and would parse HTTP/2
+	// frames as an HTTP/1.x response. Build the preset first, then constrain its
+	// ALPN extension to the protocol used by this Transport.
+	if err = tlsConn.BuildHandshakeState(); err != nil {
