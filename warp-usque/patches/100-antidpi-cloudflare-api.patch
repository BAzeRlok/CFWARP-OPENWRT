diff --git a/api/transport.go b/api/transport.go
new file mode 100644
index 0000000000000000000000000000000000000000..e40cda8c1b117135a4b2523a75efd55b970c6b5b
--- /dev/null
+++ b/api/transport.go
@@ -0,0 +1,190 @@
+package api
+
+import (
+	"context"
+	"encoding/binary"
+	"io"
+	"net"
+	"net/http"
+	"time"
+
+	utls "github.com/metacubex/utls"
+)
+
+const (
+	tlsRecordHeaderLength = 5
+	tlsHandshakeType      = 22
+	tlsClientHelloType    = 1
+	tlsSNIExtension       = 0
+)
+
+var cloudflareHTTPClient = &http.Client{
+	Timeout: 30 * time.Second,
+	Transport: &http.Transport{
+		DialTLSContext: dialCloudflareTLS,
+	},
+}
+
+func dialCloudflareTLS(ctx context.Context, network, address string) (net.Conn, error) {
+	dialer := &net.Dialer{Timeout: 10 * time.Second}
+	// Cloudflare's consumer API has stable A records. Force IPv4 so an
+	// IPv4-only OpenWrt WAN does not stall on an unusable AAAA result.
+	rawConn, err := dialer.DialContext(ctx, "tcp4", address)
+	if err != nil {
+		return nil, err
+	}
+	host, _, err := net.SplitHostPort(address)
+	if err != nil {
+		rawConn.Close()
+		return nil, err
+	}
+
+	fragmentedConn := &clientHelloFragmentConn{Conn: rawConn}
+	tlsConn := utls.UClient(fragmentedConn, &utls.Config{
+		ServerName: host,
+		NextProtos: []string{"http/1.1"},
+	}, utls.HelloChrome_Auto)
+	// Chrome fingerprints advertise multiple ALPN protocols by default. The
+	// custom transport expects HTTP/1.1, so constrain the preset before the
+	// handshake to keep response framing deterministic.
+	if err = tlsConn.BuildHandshakeState(); err != nil {
+		rawConn.Close()
+		return nil, err
+	}
+	forceHTTP1ALPN(tlsConn)
+	if err = tlsConn.HandshakeContext(ctx); err != nil {
+		rawConn.Close()
+		return nil, err
+	}
+	return tlsConn, nil
+}
+
+func forceHTTP1ALPN(conn *utls.UConn) {
+	for _, extension := range conn.Extensions {
+		if alpn, ok := extension.(*utls.ALPNExtension); ok {
+			alpn.AlpnProtocols = []string{"http/1.1"}
+			return
+		}
+	}
+	conn.Extensions = append(conn.Extensions, &utls.ALPNExtension{
+		AlpnProtocols: []string{"http/1.1"},
+	})
+}
+
+type clientHelloFragmentConn struct {
+	net.Conn
+	written bool
+}
+
+func (c *clientHelloFragmentConn) Write(payload []byte) (int, error) {
+	if c.written {
+		return c.Conn.Write(payload)
+	}
+	c.written = true
+
+	splitAt := clientHelloSNISplit(payload)
+	if splitAt <= tlsRecordHeaderLength || splitAt >= len(payload) {
+		return c.Conn.Write(payload)
+	}
+	recordLength := int(binary.BigEndian.Uint16(payload[3:5]))
+	recordEnd := tlsRecordHeaderLength + recordLength
+	if splitAt >= recordEnd || recordEnd > len(payload) {
+		return c.Conn.Write(payload)
+	}
+
+	first := makeTLSRecord(payload[:3], payload[tlsRecordHeaderLength:splitAt])
+	second := makeTLSRecord(payload[:3], payload[splitAt:recordEnd])
+	if tcpConn, ok := c.Conn.(*net.TCPConn); ok {
+		_ = tcpConn.SetNoDelay(true)
+		defer tcpConn.SetNoDelay(false)
+	}
+	if err := writeAll(c.Conn, first); err != nil {
+		return 0, err
+	}
+	time.Sleep(35 * time.Millisecond)
+	if err := writeAll(c.Conn, second); err != nil {
+		return 0, err
+	}
+	if recordEnd < len(payload) {
+		if err := writeAll(c.Conn, payload[recordEnd:]); err != nil {
+			return 0, err
+		}
+	}
+	return len(payload), nil
+}
+
+func makeTLSRecord(prefix, body []byte) []byte {
+	record := make([]byte, tlsRecordHeaderLength+len(body))
+	copy(record[:3], prefix)
+	binary.BigEndian.PutUint16(record[3:5], uint16(len(body)))
+	copy(record[tlsRecordHeaderLength:], body)
+	return record
+}
+
+func writeAll(writer io.Writer, payload []byte) error {
+	for len(payload) > 0 {
+		n, err := writer.Write(payload)
+		if err != nil {
+			return err
+		}
+		payload = payload[n:]
+	}
+	return nil
+}
+
+func clientHelloSNISplit(record []byte) int {
+	if len(record) < 44 || record[0] != tlsHandshakeType || record[5] != tlsClientHelloType {
+		return -1
+	}
+	recordLength := int(binary.BigEndian.Uint16(record[3:5]))
+	if tlsRecordHeaderLength+recordLength > len(record) {
+		return -1
+	}
+	hello := record[tlsRecordHeaderLength : tlsRecordHeaderLength+recordLength]
+	if len(hello) < 39 {
+		return -1
+	}
+	index := 4 + 2 + 32
+	if index >= len(hello) {
+		return -1
+	}
+	sessionLength := int(hello[index])
+	index += 1 + sessionLength
+	if index+2 > len(hello) {
+		return -1
+	}
+	cipherLength := int(binary.BigEndian.Uint16(hello[index : index+2]))
+	index += 2 + cipherLength
+	if index >= len(hello) {
+		return -1
+	}
+	compressionLength := int(hello[index])
+	index += 1 + compressionLength
+	if index+2 > len(hello) {
+		return -1
+	}
+	extensionsLength := int(binary.BigEndian.Uint16(hello[index : index+2]))
+	index += 2
+	extensionsEnd := index + extensionsLength
+	if extensionsEnd > len(hello) {
+		return -1
+	}
+
+	for index+4 <= extensionsEnd {
+		extensionType := binary.BigEndian.Uint16(hello[index : index+2])
+		extensionLength := int(binary.BigEndian.Uint16(hello[index+2 : index+4]))
+		index += 4
+		if index+extensionLength > extensionsEnd {
+			return -1
+		}
+		if extensionType == tlsSNIExtension && extensionLength >= 5 {
+			nameLength := int(binary.BigEndian.Uint16(hello[index+3 : index+5]))
+			nameStart := index + 5
+			if nameLength > 1 && nameStart+nameLength <= index+extensionLength {
+				return tlsRecordHeaderLength + nameStart + nameLength/2
+			}
+		}
+		index += extensionLength
+	}
+	return -1
+}
diff --git a/api/transport_test.go b/api/transport_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..11fac1227053797afaea43a29413070c38f75d22
--- /dev/null
+++ b/api/transport_test.go
@@ -0,0 +1,109 @@
+package api
+
+import (
+	"encoding/binary"
+	"reflect"
+	"testing"
+
+	utls "github.com/metacubex/utls"
+)
+
+func TestForceHTTP1ALPN(t *testing.T) {
+	connection := &utls.UConn{Extensions: []utls.TLSExtension{
+		&utls.ALPNExtension{AlpnProtocols: []string{"acme", "http/1.1"}},
+	}}
+	forceHTTP1ALPN(connection)
+
+	alpn := connection.Extensions[0].(*utls.ALPNExtension)
+	if !reflect.DeepEqual(alpn.AlpnProtocols, []string{"http/1.1"}) {
+		t.Fatalf("unexpected ALPN protocols: %v", alpn.AlpnProtocols)
+	}
+}
+
+func TestForceHTTP1ALPNAddsMissingExtension(t *testing.T) {
+	connection := &utls.UConn{}
+	forceHTTP1ALPN(connection)
+
+	if len(connection.Extensions) != 1 {
+		t.Fatalf("expected one ALPN extension, got %d", len(connection.Extensions))
+	}
+	alpn := connection.Extensions[0].(*utls.ALPNExtension)
+	if !reflect.DeepEqual(alpn.AlpnProtocols, []string{"http/1.1"}) {
+		t.Fatalf("unexpected ALPN protocols: %v", alpn.AlpnProtocols)
+	}
+}
+
+func TestClientHelloSNISplit(t *testing.T) {
+	hostname := "api.cloudflareclient.com"
+	record := syntheticClientHello(hostname)
+	splitAt := clientHelloSNISplit(record)
+	if splitAt <= tlsRecordHeaderLength || splitAt >= len(record) {
+		t.Fatalf("invalid split offset %d for %d-byte record", splitAt, len(record))
+	}
+
+	hostStart := indexBytes(record, []byte(hostname))
+	if hostStart < 0 || splitAt <= hostStart || splitAt >= hostStart+len(hostname) {
+		t.Fatalf("split offset %d is not inside SNI hostname [%d,%d)", splitAt, hostStart, hostStart+len(hostname))
+	}
+}
+
+func TestClientHelloSNISplitRejectsMalformedRecord(t *testing.T) {
+	for _, record := range [][]byte{
+		nil,
+		{tlsHandshakeType, 3, 3, 0, 1, tlsClientHelloType},
+		{23, 3, 3, 0, 1, tlsClientHelloType},
+	} {
+		if splitAt := clientHelloSNISplit(record); splitAt != -1 {
+			t.Fatalf("malformed record produced split offset %d", splitAt)
+		}
+	}
+}
+
+func syntheticClientHello(hostname string) []byte {
+	sniName := append([]byte{0}, uint16Bytes(len(hostname))...)
+	sniName = append(sniName, hostname...)
+	sniBody := append(uint16Bytes(len(sniName)), sniName...)
+	sniExtension := append([]byte{0, 0}, uint16Bytes(len(sniBody))...)
+	sniExtension = append(sniExtension, sniBody...)
+
+	helloBody := []byte{3, 3}
+	helloBody = append(helloBody, make([]byte, 32)...)
+	helloBody = append(helloBody, 0)
+	helloBody = append(helloBody, 0, 2, 0x13, 0x01)
+	helloBody = append(helloBody, 1, 0)
+	helloBody = append(helloBody, uint16Bytes(len(sniExtension))...)
+	helloBody = append(helloBody, sniExtension...)
+
+	handshake := []byte{tlsClientHelloType, 0, 0, 0}
+	handshakeLength := len(helloBody)
+	handshake[1] = byte(handshakeLength >> 16)
+	handshake[2] = byte(handshakeLength >> 8)
+	handshake[3] = byte(handshakeLength)
+	handshake = append(handshake, helloBody...)
+
+	record := []byte{tlsHandshakeType, 3, 1, 0, 0}
+	binary.BigEndian.PutUint16(record[3:5], uint16(len(handshake)))
+	return append(record, handshake...)
+}
+
+func uint16Bytes(value int) []byte {
+	result := make([]byte, 2)
+	binary.BigEndian.PutUint16(result, uint16(value))
+	return result
+}
+
+func indexBytes(haystack, needle []byte) int {
+	for index := 0; index+len(needle) <= len(haystack); index++ {
+		matched := true
+		for offset := range needle {
+			if haystack[index+offset] != needle[offset] {
+				matched = false
+				break
+			}
+		}
+		if matched {
+			return index
+		}
+	}
+	return -1
+}
