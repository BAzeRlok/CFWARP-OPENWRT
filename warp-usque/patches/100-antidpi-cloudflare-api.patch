diff --git a/api/transport.go b/api/transport.go
new file mode 100644
index 0000000..0e8fc09
--- /dev/null
+++ b/api/transport.go
@@ -0,0 +1,170 @@
+package api
+
+import (
+	"context"
+	"encoding/binary"
+	"io"
+	"net"
+	"net/http"
+	"time"
+
+	utls "github.com/metacubex/utls"
+)
+
+const (
+	tlsRecordHeaderLength = 5
+	tlsHandshakeType      = 22
+	tlsClientHelloType    = 1
+	tlsSNIExtension       = 0
+)
+
+var cloudflareHTTPClient = &http.Client{
+	Timeout: 30 * time.Second,
+	Transport: &http.Transport{
+		DialTLSContext: dialCloudflareTLS,
+	},
+}
+
+func dialCloudflareTLS(ctx context.Context, network, address string) (net.Conn, error) {
+	dialer := &net.Dialer{Timeout: 10 * time.Second}
+	// Cloudflare's consumer API has stable A records. Force IPv4 so an
+	// IPv4-only OpenWrt WAN does not stall on an unusable AAAA result.
+	rawConn, err := dialer.DialContext(ctx, "tcp4", address)
+	if err != nil {
+		return nil, err
+	}
+	host, _, err := net.SplitHostPort(address)
+	if err != nil {
+		rawConn.Close()
+		return nil, err
+	}
+
+	fragmentedConn := &clientHelloFragmentConn{Conn: rawConn}
+	tlsConn := utls.UClient(fragmentedConn, &utls.Config{
+		ServerName: host,
+		NextProtos: []string{"http/1.1"},
+	}, utls.HelloChrome_Auto)
+	if err = tlsConn.HandshakeContext(ctx); err != nil {
+		rawConn.Close()
+		return nil, err
+	}
+	return tlsConn, nil
+}
+
+type clientHelloFragmentConn struct {
+	net.Conn
+	written bool
+}
+
+func (c *clientHelloFragmentConn) Write(payload []byte) (int, error) {
+	if c.written {
+		return c.Conn.Write(payload)
+	}
+	c.written = true
+
+	splitAt := clientHelloSNISplit(payload)
+	if splitAt <= tlsRecordHeaderLength || splitAt >= len(payload) {
+		return c.Conn.Write(payload)
+	}
+	recordLength := int(binary.BigEndian.Uint16(payload[3:5]))
+	recordEnd := tlsRecordHeaderLength + recordLength
+	if splitAt >= recordEnd || recordEnd > len(payload) {
+		return c.Conn.Write(payload)
+	}
+
+	first := makeTLSRecord(payload[:3], payload[tlsRecordHeaderLength:splitAt])
+	second := makeTLSRecord(payload[:3], payload[splitAt:recordEnd])
+	if tcpConn, ok := c.Conn.(*net.TCPConn); ok {
+		_ = tcpConn.SetNoDelay(true)
+		defer tcpConn.SetNoDelay(false)
+	}
+	if err := writeAll(c.Conn, first); err != nil {
+		return 0, err
+	}
+	time.Sleep(35 * time.Millisecond)
+	if err := writeAll(c.Conn, second); err != nil {
+		return 0, err
+	}
+	if recordEnd < len(payload) {
+		if err := writeAll(c.Conn, payload[recordEnd:]); err != nil {
+			return 0, err
+		}
+	}
+	return len(payload), nil
+}
+
+func makeTLSRecord(prefix, body []byte) []byte {
+	record := make([]byte, tlsRecordHeaderLength+len(body))
+	copy(record[:3], prefix)
+	binary.BigEndian.PutUint16(record[3:5], uint16(len(body)))
+	copy(record[tlsRecordHeaderLength:], body)
+	return record
+}
+
+func writeAll(writer io.Writer, payload []byte) error {
+	for len(payload) > 0 {
+		n, err := writer.Write(payload)
+		if err != nil {
+			return err
+		}
+		payload = payload[n:]
+	}
+	return nil
+}
+
+func clientHelloSNISplit(record []byte) int {
+	if len(record) < 44 || record[0] != tlsHandshakeType || record[5] != tlsClientHelloType {
+		return -1
+	}
+	recordLength := int(binary.BigEndian.Uint16(record[3:5]))
+	if tlsRecordHeaderLength+recordLength > len(record) {
+		return -1
+	}
+	hello := record[tlsRecordHeaderLength : tlsRecordHeaderLength+recordLength]
+	if len(hello) < 39 {
+		return -1
+	}
+	index := 4 + 2 + 32
+	if index >= len(hello) {
+		return -1
+	}
+	sessionLength := int(hello[index])
+	index += 1 + sessionLength
+	if index+2 > len(hello) {
+		return -1
+	}
+	cipherLength := int(binary.BigEndian.Uint16(hello[index : index+2]))
+	index += 2 + cipherLength
+	if index >= len(hello) {
+		return -1
+	}
+	compressionLength := int(hello[index])
+	index += 1 + compressionLength
+	if index+2 > len(hello) {
+		return -1
+	}
+	extensionsLength := int(binary.BigEndian.Uint16(hello[index : index+2]))
+	index += 2
+	extensionsEnd := index + extensionsLength
+	if extensionsEnd > len(hello) {
+		return -1
+	}
+
+	for index+4 <= extensionsEnd {
+		extensionType := binary.BigEndian.Uint16(hello[index : index+2])
+		extensionLength := int(binary.BigEndian.Uint16(hello[index+2 : index+4]))
+		index += 4
+		if index+extensionLength > extensionsEnd {
+			return -1
+		}
+		if extensionType == tlsSNIExtension && extensionLength >= 5 {
+			nameLength := int(binary.BigEndian.Uint16(hello[index+3 : index+5]))
+			nameStart := index + 5
+			if nameLength > 1 && nameStart+nameLength <= index+extensionLength {
+				return tlsRecordHeaderLength + nameStart + nameLength/2
+			}
+		}
+		index += extensionLength
+	}
+	return -1
+}
