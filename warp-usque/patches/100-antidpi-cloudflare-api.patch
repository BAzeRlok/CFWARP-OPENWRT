 )
 
+func TestForceHTTP1ALPN(t *testing.T) {
+	connection := &utls.UConn{Extensions: []utls.TLSExtension{
+		&utls.ALPNExtension{AlpnProtocols: []string{"h2", "http/1.1"}},
+	}}
+	forceHTTP1ALPN(connection)
+
+	alpn := connection.Extensions[0].(*utls.ALPNExtension)
+	if !reflect.DeepEqual(alpn.AlpnProtocols, []string{"http/1.1"}) {
+		t.Fatalf("unexpected ALPN protocols: %v", alpn.AlpnProtocols)
+	}
+}
+
+func TestForceHTTP1ALPNAddsMissingExtension(t *testing.T) {
+	connection := &utls.UConn{}
+	forceHTTP1ALPN(connection)
+
+	if len(connection.Extensions) != 1 {
+		t.Fatalf("expected one ALPN extension, got %d", len(connection.Extensions))
+	}
+	alpn := connection.Extensions[0].(*utls.ALPNExtension)
+	if !reflect.DeepEqual(alpn.AlpnProtocols, []string{"http/1.1"}) {
+		t.Fatalf("unexpected ALPN protocols: %v", alpn.AlpnProtocols)
