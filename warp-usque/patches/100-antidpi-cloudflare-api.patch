--- /dev/null
+++ b/api/transport_test.go
@@ -0,0 +1,81 @@
+package api
+
+import (
+	"encoding/binary"
+	"testing"
+)
+
+func TestClientHelloSNISplit(t *testing.T) {
+	hostname := "api.cloudflareclient.com"
+	record := syntheticClientHello(hostname)
+	splitAt := clientHelloSNISplit(record)
+	if splitAt <= tlsRecordHeaderLength || splitAt >= len(record) {
+		t.Fatalf("invalid split offset %d for %d-byte record", splitAt, len(record))
+	}
+
+	hostStart := indexBytes(record, []byte(hostname))
+	if hostStart < 0 || splitAt <= hostStart || splitAt >= hostStart+len(hostname) {
+		t.Fatalf("split offset %d is not inside SNI hostname [%d,%d)", splitAt, hostStart, hostStart+len(hostname))
+	}
+}
+
+func TestClientHelloSNISplitRejectsMalformedRecord(t *testing.T) {
+	for _, record := range [][]byte{
+		nil,
+		{tlsHandshakeType, 3, 3, 0, 1, tlsClientHelloType},
+		{23, 3, 3, 0, 1, tlsClientHelloType},
+	} {
+		if splitAt := clientHelloSNISplit(record); splitAt != -1 {
+			t.Fatalf("malformed record produced split offset %d", splitAt)
+		}
+	}
+}
+
+func syntheticClientHello(hostname string) []byte {
+	sniName := append([]byte{0}, uint16Bytes(len(hostname))...)
+	sniName = append(sniName, hostname...)
+	sniBody := append(uint16Bytes(len(sniName)), sniName...)
+	sniExtension := append([]byte{0, 0}, uint16Bytes(len(sniBody))...)
+	sniExtension = append(sniExtension, sniBody...)
+
+	helloBody := []byte{3, 3}
+	helloBody = append(helloBody, make([]byte, 32)...)
+	helloBody = append(helloBody, 0)
+	helloBody = append(helloBody, 0, 2, 0x13, 0x01)
+	helloBody = append(helloBody, 1, 0)
+	helloBody = append(helloBody, uint16Bytes(len(sniExtension))...)
+	helloBody = append(helloBody, sniExtension...)
+
+	handshake := []byte{tlsClientHelloType, 0, 0, 0}
+	handshakeLength := len(helloBody)
+	handshake[1] = byte(handshakeLength >> 16)
+	handshake[2] = byte(handshakeLength >> 8)
+	handshake[3] = byte(handshakeLength)
+	handshake = append(handshake, helloBody...)
+
+	record := []byte{tlsHandshakeType, 3, 1, 0, 0}
+	binary.BigEndian.PutUint16(record[3:5], uint16(len(handshake)))
+	return append(record, handshake...)
+}
+
+func uint16Bytes(value int) []byte {
+	result := make([]byte, 2)
+	binary.BigEndian.PutUint16(result, uint16(value))
+	return result
+}
+
+func indexBytes(haystack, needle []byte) int {
+	for index := 0; index+len(needle) <= len(haystack); index++ {
+		matched := true
+		for offset := range needle {
+			if haystack[index+offset] != needle[offset] {
+				matched = false
+				break
+			}
+		}
+		if matched {
+			return index
+		}
+	}
+	return -1
+}
