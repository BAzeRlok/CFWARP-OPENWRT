+func endpointMatchesTransport(endpoint net.Addr, useHTTP2 bool) bool {
+	if useHTTP2 {
+		_, ok := endpoint.(*net.TCPAddr)
+		return ok
+	}
+	_, ok := endpoint.(*net.UDPAddr)
+	return ok
+}
+
+func activateHTTP2Fallback(useHTTP2 *bool, endpoint *net.Addr, fallback net.Addr) bool {
+	if *useHTTP2 || fallback == nil || !endpointMatchesTransport(fallback, true) {
+		return false
+	}
+	*useHTTP2 = true
+	*endpoint = fallback
+	return true
+}
