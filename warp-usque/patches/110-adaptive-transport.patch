diff --git a/api/tunnel_fallback_test.go b/api/tunnel_fallback_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..1137128c171c772ef592e9fdc585a4f60f6590e8
--- /dev/null
+++ b/api/tunnel_fallback_test.go
@@ -0,0 +1,38 @@
+package api
+
+import (
+	"net"
+	"testing"
+)
+
+func TestActivateHTTP2Fallback(t *testing.T) {
+	useHTTP2 := false
+	var endpoint net.Addr = &net.UDPAddr{IP: net.IPv4(162, 159, 198, 2), Port: 443}
+	fallback := &net.TCPAddr{IP: net.IPv4(162, 159, 198, 2), Port: 443}
+
+	if !activateHTTP2Fallback(&useHTTP2, &endpoint, fallback) {
+		t.Fatal("expected fallback activation")
+	}
+	if !useHTTP2 {
+		t.Fatal("HTTP/2 was not selected")
+	}
+	if endpoint != fallback {
+		t.Fatalf("unexpected fallback endpoint: %v", endpoint)
+	}
+	if activateHTTP2Fallback(&useHTTP2, &endpoint, fallback) {
+		t.Fatal("fallback activated twice")
+	}
+}
+
+func TestActivateHTTP2FallbackRejectsInvalidEndpoint(t *testing.T) {
+	useHTTP2 := false
+	var endpoint net.Addr = &net.UDPAddr{IP: net.IPv4zero, Port: 443}
+	invalidFallback := &net.UDPAddr{IP: net.IPv4zero, Port: 443}
+
+	if activateHTTP2Fallback(&useHTTP2, &endpoint, invalidFallback) {
+		t.Fatal("accepted a non-TCP fallback endpoint")
+	}
+	if useHTTP2 {
+		t.Fatal("transport changed after invalid fallback")
+	}
+}
