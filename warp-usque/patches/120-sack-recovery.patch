+// tcpSACKRecoveryCopies returns the number of CONNECT-IP datagrams to send
+// for packet. Only payload-free TCP ACKs with a valid SACK option are repeated;
+// these packets already prove that the receiver observed data beyond a gap.
+func tcpSACKRecoveryCopies(packet []byte) int {
+	tcpOffset, packetEnd, ok := tcpPacketBounds(packet)
+	if !ok || tcpOffset+20 > packetEnd {
+		return 1
+	}
+
+	tcpHeaderLength := int(packet[tcpOffset+12]>>4) * 4
+	if tcpHeaderLength < 20 || tcpOffset+tcpHeaderLength != packetEnd {
+		return 1
+	}
+
+	flags := packet[tcpOffset+13]
+	const (
+		tcpFIN = 0x01
+		tcpSYN = 0x02
+		tcpRST = 0x04
+		tcpACK = 0x10
+	)
+	if flags&tcpACK == 0 || flags&(tcpFIN|tcpSYN|tcpRST) != 0 {
+		return 1
+	}
+
+	options := packet[tcpOffset+20 : tcpOffset+tcpHeaderLength]
+	for offset := 0; offset < len(options); {
+		kind := options[offset]
+		switch kind {
+		case 0:
+			return 1
+		case 1:
+			offset++
+			continue
+		}
+
+		if offset+2 > len(options) {
+			return 1
+		}
+		optionLength := int(options[offset+1])
+		if optionLength < 2 || offset+optionLength > len(options) {
+			return 1
+		}
+		if kind == 5 && optionLength >= 10 && (optionLength-2)%8 == 0 {
+			return sackRecoveryCopies
+		}
+		offset += optionLength
+	}
+
+	return 1
+}
