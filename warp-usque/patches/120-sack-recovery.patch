+// tcpPacketBounds returns the TCP header offset and logical end of an IPv4 or
+// simple IPv6 packet. IPv6 extension headers are deliberately left untouched.
+func tcpPacketBounds(packet []byte) (int, int, bool) {
+	if len(packet) == 0 {
+		return 0, 0, false
+	}
+
+	switch packet[0] >> 4 {
+	case 4:
+		if len(packet) < 20 || packet[9] != 6 {
+			return 0, 0, false
+		}
+		ipHeaderLength := int(packet[0]&0x0f) * 4
+		packetLength := int(binary.BigEndian.Uint16(packet[2:4]))
+		fragment := binary.BigEndian.Uint16(packet[6:8])
+		if ipHeaderLength < 20 || packetLength < ipHeaderLength+20 || packetLength > len(packet) || fragment&0x3fff != 0 {
+			return 0, 0, false
+		}
+		return ipHeaderLength, packetLength, true
+	case 6:
+		if len(packet) < 40 || packet[6] != 6 {
+			return 0, 0, false
+		}
+		packetLength := 40 + int(binary.BigEndian.Uint16(packet[4:6]))
+		if packetLength < 60 || packetLength > len(packet) {
+			return 0, 0, false
+		}
+		return 40, packetLength, true
+	default:
+		return 0, 0, false
+	}
+}
