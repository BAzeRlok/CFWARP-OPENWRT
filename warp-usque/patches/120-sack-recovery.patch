+func TestTCPSACKRecoveryCopies(t *testing.T) {
+	sackWithData := append(testTCPPacket(4, 0x10, []byte{1, 1, 5, 10, 0, 0, 0, 10, 0, 0, 0, 20, 0, 0, 0, 0}), 1)
+	binary.BigEndian.PutUint16(sackWithData[2:4], uint16(len(sackWithData)))
+
+	tests := []struct {
+		name   string
+		packet []byte
+		want   int
+	}{
+		{name: "IPv4 SACK ACK", packet: testTCPPacket(4, 0x10, []byte{1, 1, 5, 10, 0, 0, 0, 10, 0, 0, 0, 20, 0, 0, 0, 0}), want: sackRecoveryCopies},
+		{name: "IPv6 SACK ACK", packet: testTCPPacket(6, 0x10, []byte{1, 1, 5, 10, 0, 0, 0, 10, 0, 0, 0, 20, 0, 0, 0, 0}), want: sackRecoveryCopies},
+		{name: "ordinary ACK", packet: testTCPPacket(4, 0x10, []byte{1, 1, 8, 10, 0, 0, 0, 1, 0, 0, 0, 2}), want: 1},
+		{name: "SACK with data", packet: sackWithData, want: 1},
+		{name: "SACK with FIN", packet: testTCPPacket(4, 0x11, []byte{1, 1, 5, 10, 0, 0, 0, 10, 0, 0, 0, 20, 0, 0, 0, 0}), want: 1},
+		{name: "invalid SACK", packet: testTCPPacket(4, 0x10, []byte{1, 1, 5, 9, 0, 0, 0, 10, 0, 0, 0, 0}), want: 1},
+		{name: "truncated packet", packet: []byte{0x45}, want: 1},
+	}
+
+	for _, test := range tests {
+		t.Run(test.name, func(t *testing.T) {
+			if got := tcpSACKRecoveryCopies(test.packet); got != test.want {
+				t.Fatalf("tcpSACKRecoveryCopies() = %d, want %d", got, test.want)
+			}
+		})
+	}
+}
+
+func testTCPPacket(version, flags byte, options []byte) []byte {
+	if remainder := len(options) % 4; remainder != 0 {
+		options = append(options, make([]byte, 4-remainder)...)
+	}
+	tcpLength := 20 + len(options)
+	ipLength := 20
+	if version == 6 {
+		ipLength = 40
+	}
+	packet := make([]byte, ipLength+tcpLength)
+	packet[0] = version << 4
+	if version == 4 {
+		packet[0] |= 5
+		binary.BigEndian.PutUint16(packet[2:4], uint16(len(packet)))
+		packet[9] = 6
+	} else {
+		binary.BigEndian.PutUint16(packet[4:6], uint16(tcpLength))
+		packet[6] = 6
+	}
+	packet[ipLength+12] = byte(tcpLength/4) << 4
+	packet[ipLength+13] = flags
+	copy(packet[ipLength+20:], options)
+	return packet
+}
