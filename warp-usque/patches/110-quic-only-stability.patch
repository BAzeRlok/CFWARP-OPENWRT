diff --git a/api/tunnel_quic_test.go b/api/tunnel_quic_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..bf3426a2edf27e0465434b5e28c1b677c299a764
--- /dev/null
+++ b/api/tunnel_quic_test.go
@@ -0,0 +1,70 @@
+package api
+
+import (
+	"bytes"
+	"context"
+	"errors"
+	"testing"
+	"time"
+)
+
+type deviceReadResult struct {
+	packet []byte
+	err    error
+}
+
+type fakeTunnelDevice struct {
+	reads chan deviceReadResult
+}
+
+func (f *fakeTunnelDevice) ReadPacket(buf []byte) (int, error) {
+	result := <-f.reads
+	if result.err != nil {
+		return 0, result.err
+	}
+	return copy(buf, result.packet), nil
+}
+
+func (f *fakeTunnelDevice) WritePacket([]byte) error { return nil }
+
+func TestDevicePacketQueueStaysLowLatency(t *testing.T) {
+	if devicePacketQueueSize != 1 {
+		t.Fatalf("unexpected device packet queue size: got %d, want 1", devicePacketQueueSize)
+	}
+}
+
+func TestDevicePacketReaderPreservesPacketsAcrossConsumers(t *testing.T) {
+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+	device := &fakeTunnelDevice{reads: make(chan deviceReadResult, 3)}
+	device.reads <- deviceReadResult{packet: []byte{1, 2, 3}}
+	device.reads <- deviceReadResult{packet: []byte{4, 5, 6}}
+	device.reads <- deviceReadResult{err: errors.New("device closed")}
+
+	pool := NewNetBuffer(128)
+	packets := startDevicePacketReader(ctx, device, pool)
+	for _, expected := range [][]byte{{1, 2, 3}, {4, 5, 6}} {
+		select {
+		case packet := <-packets:
+			if packet.err != nil {
+				t.Fatalf("unexpected read error: %v", packet.err)
+			}
+			actual := packet.buf[datagramContextIDHeadroom : datagramContextIDHeadroom+packet.size]
+			if !bytes.Equal(actual, expected) {
+				t.Fatalf("packet = %v, want %v", actual, expected)
+			}
+			pool.Put(packet.buf)
+		case <-time.After(time.Second):
+			t.Fatal("timed out waiting for packet")
+		}
+	}
+
+	select {
+	case packet := <-packets:
+		if packet == nil || packet.err == nil {
+			t.Fatalf("expected terminal device error, got %#v", packet)
+		}
+	case <-time.After(time.Second):
+		t.Fatal("timed out waiting for device error")
+	}
+}
